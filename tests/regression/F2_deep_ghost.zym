// SEVERITY: leak the ghost with a DEEP frame_index, then fire it from a
// SHALLOW stack, so prompt->frame_index > vm->frame_count.
var OUTER = Cont.newPrompt("OUTER")
var INNER = Cont.newPrompt("INNER")

func inner() {
    Cont.abort(OUTER, 1)
    return 0
}
func outer() {
    return Cont.withPrompt(INNER, inner)
}

func d5() { return Cont.withPrompt(OUTER, outer) }
func d4() { var a = 40 var b = 41 var c = d5() return c }
func d3() { var a = 30 var b = 31 var c = d4() return c }
func d2() { var a = 20 var b = 21 var c = d3() return c }
func d1() { var a = 10 var b = 11 var c = d2() return c }

var r = d1()
print("deep nest returned:")
print(r)
print("--- firing the ghost from top level (shallow stack) ---")
var g = Cont.abort(OUTER, 99)
print("ghost abort returned:")
print(g)
print("still alive; now stressing the stack")
var acc = 0
var i = 0
while (i < 5000) {
    var m = { a: i, b: i + 1 }
    acc = acc + m.a + m.b
    i = i + 1
}
print("acc =")
print(acc)
print("DONE")
