//
// ZYM UI SHOWCASE v2 — full DrawList API, custom widgets, expanded drawing modes
//
// Pages:
//   1. Widgets      — every input/display primitive + DnD
//   2. Layout       — containers, groups, scroll, trees, tabs
//   3. Data         — animated plots, sortable/filterable/DnD table
//   4. Drawing      — 8 parametric drawing modes using DrawList API
//   5. Custom       — hand-crafted widgets: knob, toggle, radial progress,
//                     bezier editor, radar chart, sparkline, gradient card
//   6. Theme        — live accent/rounding/density editor
//   7. About        — perf metrics, runtime info

var win = SDL.createWindow("zym ui showcase", 1280, 800, { resizable: true })
if (win == null) { print("failed: %v", SDL.lastError()); return }

// ---------------------------------------------------------------------------
// Theme
// ---------------------------------------------------------------------------

var accent   = [[0.38, 0.72, 0.98, 1.0]]
var rounding = [8.0]
var density  = [1]

var mix = func(a, b, t) {
    return [a[0]*(1-t)+b[0]*t, a[1]*(1-t)+b[1]*t, a[2]*(1-t)+b[2]*t, a[3]*(1-t)+b[3]*t]
}
var black = [0,0,0,1]
var white = [1,1,1,1]

var buildColors = func() {
    var ac = accent[0]
    var ah = mix(ac, white, 0.18)
    var aa = mix(ac, black, 0.18)
    var dim = mix(ac, black, 0.55)
    return {
        WindowBg:              [0.06, 0.07, 0.09, 1.0],
        ChildBg:               [0.09, 0.10, 0.13, 1.0],
        PopupBg:               [0.10, 0.11, 0.15, 0.98],
        Border:                [1.0, 1.0, 1.0, 0.06],
        BorderShadow:          [0,0,0,0],
        Text:                  [0.93, 0.95, 0.98, 1.0],
        TextDisabled:          [0.48, 0.52, 0.60, 1.0],
        TextSelectedBg:        mix(ac, black, 0.45),
        FrameBg:               [1.0, 1.0, 1.0, 0.04],
        FrameBgHovered:        [1.0, 1.0, 1.0, 0.08],
        FrameBgActive:         mix([1,1,1,0.10], ac, 0.35),
        TitleBg:               [0.07, 0.08, 0.11, 1.0],
        TitleBgActive:         [0.10, 0.11, 0.15, 1.0],
        TitleBgCollapsed:      [0.05, 0.06, 0.09, 1.0],
        MenuBarBg:             [0.07, 0.08, 0.11, 1.0],
        ScrollbarBg:           [0,0,0,0],
        ScrollbarGrab:         [1,1,1,0.08],
        ScrollbarGrabHovered:  [1,1,1,0.14],
        ScrollbarGrabActive:   ac,
        CheckMark:             ac,
        CheckboxSelectedBg:    dim,
        SliderGrab:            ac,
        SliderGrabActive:      aa,
        Button:                [1,1,1,0.05],
        ButtonHovered:         mix([1,1,1,0.08], ac, 0.55),
        ButtonActive:          ac,
        Header:                mix(ac, black, 0.55),
        HeaderHovered:         mix(ac, black, 0.30),
        HeaderActive:          ac,
        Separator:             [1,1,1,0.07],
        SeparatorHovered:      ah,
        SeparatorActive:       ac,
        ResizeGrip:            [1,1,1,0.04],
        ResizeGripHovered:     ah,
        ResizeGripActive:      ac,
        Tab:                   [0,0,0,0],
        TabHovered:            mix(ac, black, 0.35),
        TabSelected:           ac,
        TabSelectedOverline:   ac,
        TabDimmed:             [0,0,0,0],
        TabDimmedSelected:     mix(ac, black, 0.50),
        PlotLines:             ac,
        PlotLinesHovered:      ah,
        PlotHistogram:         ac,
        PlotHistogramHovered:  ah,
        TableHeaderBg:         [0.10, 0.11, 0.15, 1.0],
        TableBorderStrong:     [1,1,1,0.07],
        TableBorderLight:      [1,1,1,0.03],
        TableRowBg:            [0,0,0,0],
        TableRowBgAlt:         [1,1,1,0.02],
        NavCursor:             ac,
        ModalWindowDimBg:      [0,0,0,0.55],
    }
}

var buildVars = func() {
    var fp = [8.0, 5.0]; var is = [8.0, 5.0]
    if (density[0] == 1) { fp = [12.0, 8.0]; is = [10.0, 7.0] }
    if (density[0] == 2) { fp = [16.0, 11.0]; is = [14.0, 10.0] }
    var r = rounding[0]
    return {
        WindowRounding: r, ChildRounding: r, FrameRounding: r*0.6,
        PopupRounding: r, ScrollbarRounding: r, GrabRounding: r*0.6,
        TabRounding: r*0.5, TabBarOverlineSize: 2.0,
        WindowPadding: [20.0, 16.0], FramePadding: fp,
        CellPadding: [10.0, 6.0], ItemSpacing: is,
        ItemInnerSpacing: [8.0, 6.0], IndentSpacing: 18.0,
        ScrollbarSize: 10.0, GrabMinSize: 10.0,
        WindowBorderSize: 0.0, FrameBorderSize: 0.0,
        ChildBorderSize: 0.0, PopupBorderSize: 1.0,
        SeparatorTextBorderSize: 1.0,
        SeparatorTextAlign: [0.0, 0.5],
        SeparatorTextPadding: [18.0, 6.0],
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

var packColor = func(c) { return UI.color(c[0]*255, c[1]*255, c[2]*255, c[3]*255) }
var secHeader = func(title, sub) {
    UI.separatorText(title)
    if (sub != "") { UI.textDisabled(sub) }
    UI.dummy(0, 4)
}

var PI  = 3.14159265358979
var PI2 = PI * 2.0

var hsvToRgb = func(h, s, v) {
    var i = floor(h * 6); var f = h*6-i
    var p = v*(1-s); var q = v*(1-f*s); var t = v*(1-(1-f)*s)
    var m = i % 6
    if (m == 0) { return [v,t,p,1] } if (m == 1) { return [q,v,p,1] }
    if (m == 2) { return [p,v,t,1] } if (m == 3) { return [p,q,v,1] }
    if (m == 4) { return [t,p,v,1] } return [v,p,q,1]
}

var pushSample = func(buf, v) {
    var i = 0; var n = length(buf)-1
    while (i < n) { buf[i] = buf[i+1]; i++ }
    buf[n] = v
}

