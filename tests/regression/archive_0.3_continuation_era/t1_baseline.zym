// Baseline: recurring entry, NO continuation capture. Should fire many times.
var hits = 0
var id = Preempt.every(2000, func() { hits = hits + 1 })

var s = 0
for (var i = 0; i < 200000; i = i + 1) { s = s + i }

print("baseline hits=%v remaining=%v ids=%v", hits, Preempt.remaining(id), Preempt.ids())
