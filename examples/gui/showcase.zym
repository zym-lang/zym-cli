// ---------------------------------------------------------------------------
// Shared sort helper
// ---------------------------------------------------------------------------

var cmpStr = func(a, b) {
    var la = length(a); var lb = length(b); var n = la; if (lb<n){n=lb}
    var i = 0
    while (i < n) {
        var ca = charCodeAt(a,i); var cb = charCodeAt(b,i)
        if (ca<cb){return -1} if (ca>cb){return 1}
        i++
    }
    if (la<lb){return -1} if (la>lb){return 1} return 0
}

var sortTable = func() {
    var col = tableSort[0]; var asc = tableSortDir[0] == 1
    var n = length(tableData); var i = 1
    while (i < n) {
        var cur = tableData[i]; var j = i-1
        while (j >= 0) {
            var a = tableData[j]; var cmp = 0
            if (col==0){cmp=cmpStr(a.name,cur.name)}
            else{if(col==1){cmp=cmpStr(a.type,cur.type)}
            else{if(col==2){if(a.size<cur.size){cmp=-1}else{if(a.size>cur.size){cmp=1}}}
            else{if(col==3){cmp=cmpStr(a.status,cur.status)}
            else{if(a.score<cur.score){cmp=-1}else{if(a.score>cur.score){cmp=1}}}}}}
            if (!asc) { cmp = -cmp }
            if (cmp <= 0) { break }
            tableData[j+1] = a; j--
        }
        tableData[j+1] = cur; i++
    }
}

var statusColor = func(s) {
    if (s=="active")   { return [0.30,0.80,0.50,1] }
    if (s=="idle")     { return [0.48,0.52,0.60,1] }
    if (s=="error")    { return [0.85,0.32,0.32,1] }
    if (s=="degraded") { return [0.90,0.65,0.20,1] }
    return [0.5,0.5,0.5,1]
}

