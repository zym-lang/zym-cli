// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------
var r1 = case1()
print("[1] callee after resume       = %v  (expect 2044)", r1)
assert(r1 == 2044, "[1] spilled locals of a resumed frame were overwritten by its callee")

var r2 = case2()
print("[2] clobbered while suspended = %v  (expect 2044)", r2)
assert(r2 == 2044, "[2] spilled locals were not snapshotted -- overwritten while suspended")

var r3 = case3()
print("[3] two captured frames       = %v  (expect 12088)", r3)
assert(r3 == 12088, "[3] nested captured frames did not each get their own spill base back")

var r4 = case4()
print("[4] heap objects in spills    = %v  (expect obj-252|obj-255|obj-259)", r4)
assert(r4 == "obj-252|obj-255|obj-259", "[4] a collection while suspended did not treat the captured spills as roots")

var r5 = case5()
print("[5] Cont.shift round trip     = %v  (expect 2044)", r5)
assert(r5 == 2044, "[5] spilled locals lost across a Cont.shift capture and resume")

print("C3 OK")
