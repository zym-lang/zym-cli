#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import platform_windows_builders

from methods import redirect_emitter

# zym: DisplayServer / TTS / native menu / drop target / GL / Vulkan / ANGLE
# / D3D12 / console-wrapper / accesskit / MSVC / editor / executable /
# shared-library paths removed. The CLI is headless and is only ever built
# as: target=template_release, library_type=static_library, mingw (not
# msvc), arch=x86_64, no accesskit, no d3d12, no debug_symbols. We link
# `-mconsole` ourselves in CMake so the gui-subsystem console wrapper is
# unnecessary. Mirrors the Linux pruning done in platform/linuxbsd/SCsub.
common_win = [
    "os_windows.cpp",
    "windows_terminal_logger.cpp",
    "windows_utils.cpp",
    "libgodot_windows.cpp",
    "crash_handler_windows_signal.cpp",
]

sources = []

env["BUILDERS"]["RES"].emitter = redirect_emitter
res_obj = env.RES("godot_res_template" + env["OBJSUFFIX"], "godot_res_template.rc")
env.Depends(res_obj, "#core/version_generated.gen.h")

env.add_source_files(sources, common_win)
sources += res_obj

prog = env.add_library("#bin/godot", sources, PROGSUFFIX=env["PROGSUFFIX"])

env.Depends(prog, "godot.manifest")

env.platform_sources += sources
