// Slice 1 PR 2a smoke test (future/gui.md §1.3).
//
// Opens a window, runs an ImGui frame loop with one window containing
// a button and a label. Click the button or close the window to exit.
//
// Manual run only — needs a display, not in runAll.sh.
//
// Usage:
//   zym run examples/gui/widgets.zym

print("sdl version: %v", sdl.version())

var win = sdl.createWindow("zym ui smoke test", 480, 240, {
    resizable: true,
})
if (win == null) {
    print("createWindow failed: %v", sdl.lastError())
    return
}

var clicks = 0
var done   = false

while (!win.shouldClose() and !done) {
    // Drain events. The ui native installs a hook so events flow to
    // ImGui automatically — scripts just keep pulling.
    var e = sdl.pollEvent()
    while (e != null) {
        if (e.type == "quit") { done = true }
        e = sdl.pollEvent()
    }

    ui.frame(win, func() {
        ui.window("hello", func() {
            ui.text("hello from zym + imgui")
            if (ui.button("click me")) {
                clicks = clicks + 1
                print("click %v", clicks)
            }
            ui.text("clicks: " + str(clicks))
        })
    })
}

win.free()
print("done — total clicks: %v", clicks)
