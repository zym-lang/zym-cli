// Slice 2 smoke test (future/gui.md §2.3, PR 6).
//
// Exercises the SDL.Texture surface — Surface → Texture publish,
// partial and full updates, blend / scale / alpha / color mods, and
// the optional `link: true` back-reference that enables tex.refresh().
//
// Requires a display because textures are bound to a Window's
// renderer. There is no UI consumer in PR 6, so this example just
// builds the textures, runs the API on them, prints their state, and
// closes the window after a brief idle. PR 7 lands UI.image and the
// DrawList image methods that turn these textures into something
// visible.
//
// Usage:
//   zym examples/gui/texture.zym
//
// What it exercises:
//   1. Open a Window (createTexture needs a renderer).
//   2. createTexture(w, h, { access: "streaming" }) → standalone texture.
//   3. textureFromSurface(surface) → texture bound to a freshly-built
//      surface, no link.
//   4. textureFromSurface(surface, { link: true }) → linked texture;
//      mutate the upstream surface, call tex.refresh(), confirm the
//      texture handle stayed stable (same `__tex__` slot).
//   5. tex.update(surface) full re-upload + tex.update(surface, rect)
//      partial dst-rect update + tex.updateRect(surface, x, y, w, h).
//   6. setBlendMode / setScaleMode / setAlphaMod / setColorMod.
//   7. tex.source() returns the linked surface; non-linked returns null.
//   8. tex.free() is idempotent; using a freed texture raises a clean
//      runtime error (caught and reported, not a crash).

print("sdl version: %v", SDL.version())

var win = SDL.createWindow("texture smoke test", 320, 240, { hidden: true })
if (win == null) {
    print("createWindow failed: %s", SDL.lastError())
    return
}

// ----- 1. standalone texture via createTexture -----

var tex = win.createTexture(128, 128, { access: "streaming" })
if (tex == null) {
    print("createTexture failed: %s", SDL.lastError())
    win.free()
    return
}
print("createTexture: size=%v", tex.size())

// ----- 2. build a Surface and publish via textureFromSurface (no link) -----

var src = SDL.Surface.new(64, 64, null)
src.fill([0.10, 0.40, 0.85, 1.0], null)
src.fill([1, 1, 0, 1], { x: 8, y: 8, w: 48, h: 48 })

var tex2 = win.textureFromSurface(src, null)
if (tex2 == null) {
    print("textureFromSurface failed: %s", SDL.lastError())
    win.free()
    return
}
print("textureFromSurface: size=%v source=%v", tex2.size(), tex2.source())

// ----- 3. linked texture: edit upstream surface, refresh, sample -----

var src2 = SDL.Surface.new(64, 64, null)
src2.clear([0, 0, 0, 1])

var linked = win.textureFromSurface(src2, { link: true })
if (linked == null) {
    print("textureFromSurface (linked) failed: %s", SDL.lastError())
    win.free()
    return
}
print("linked: source != null -> %v", linked.source() != null)

// Mutate upstream, then publish via refresh().
src2.fill([1, 0.2, 0.2, 1], null)
if (!linked.refresh(null)) {
    print("linked.refresh failed: %s", SDL.lastError())
}
print("after refresh, linked.size=%v (handle stable)", linked.size())

// Partial refresh using a dirty rect.
src2.fill([0.2, 1, 0.2, 1], { x: 0, y: 0, w: 32, h: 32 })
if (!linked.refresh({ x: 0, y: 0, w: 32, h: 32 })) {
    print("linked.refresh(dirtyRect) failed: %s", SDL.lastError())
}

// ----- 4. full + partial update via update() / updateRect() -----

if (!tex2.update(src, null)) {
    print("tex2.update(full) failed: %s", SDL.lastError())
}
if (!tex2.update(src, { x: 0, y: 0, w: 32, h: 32 })) {
    print("tex2.update(partial) failed: %s", SDL.lastError())
}
if (!tex2.updateRect(src, 0, 0, 16, 16)) {
    print("tex2.updateRect failed: %s", SDL.lastError())
}

// ----- 5. mods + blend + scale -----

if (!tex.setBlendMode("blend"))   { print("setBlendMode failed: %s", SDL.lastError()) }
if (!tex.setScaleMode("nearest")) { print("setScaleMode failed: %s", SDL.lastError()) }
if (!tex.setAlphaMod(180))        { print("setAlphaMod failed: %s", SDL.lastError()) }
if (!tex.setColorMod(255, 200, 100)) { print("setColorMod failed: %s", SDL.lastError()) }
print("mods applied on tex")

// ----- 6. source() on non-linked returns null -----

print("tex2.source() (no link) = %v", tex2.source())

// ----- 7. free is idempotent -----

tex.free()
tex.free()  // safe second call

// ----- 8. cleanup -----

tex2.free()
linked.free()
src.free()
src2.free()
win.free()

print("done")
