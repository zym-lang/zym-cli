// Copyright (c) 2026 Anatole DP
//
// ZYM UI.anim* SHOWCASE — a focused tour of the ImAnim bindings.
//
// Pages:
//   1. Easings   — preset + parametric easing previews via animEvalPreset / tween
//   2. Tweens    — float / vec2 / vec4 / color tweens with policies and rebase
//   3. Waveforms — oscillate / shake / wiggle on multiple value kinds
//   4. Drag      — inertial drag feedback with snap points
//   5. Paths     — motion path builder + along-path tween + arc-length
//   6. Color     — gradient builder + transform interp + style snapshots
//   7. Clips     — keyframed clip authoring + instance playback
//   8. UI Feel   — micro-interactions on real widgets: hover scale, glow,
//                  card highlight, text fade-in, animated underline
//
// Drawing uses the flat top-level UI.draw* primitives (screen coords).
// `UI.getCursorPos()` returns the current draw cursor in screen coords.

var win = SDL.createWindow("zym ui.anim showcase", 1200, 780, { resizable: true })
if (win == null) { print("failed: %v", SDL.lastError()); return }

// ---------------------------------------------------------------------------
// Shared state
// ---------------------------------------------------------------------------

var PI  = 3.14159265358979
var PI2 = PI * 2.0

var clockStart = Time.clock()
var lastT      = 0.0
var frame      = 0

// ---------------------------------------------------------------------------
// Page 1: easing curve previews
// ---------------------------------------------------------------------------

var easeNames = [
    "Linear", "InQuad", "OutQuad", "InOutQuad",
    "InCubic", "OutCubic", "InOutCubic",
    "InQuart", "OutQuart", "InOutQuart",
    "InQuint", "OutQuint", "InOutQuint",
    "InSine", "OutSine", "InOutSine",
    "InExpo", "OutExpo", "InOutExpo",
    "InCirc", "OutCirc", "InOutCirc",
]
var easeIds = [
    UI.ANIM_EASE_LINEAR,
    UI.ANIM_EASE_IN_QUAD,     UI.ANIM_EASE_OUT_QUAD,     UI.ANIM_EASE_IN_OUT_QUAD,
    UI.ANIM_EASE_IN_CUBIC,    UI.ANIM_EASE_OUT_CUBIC,    UI.ANIM_EASE_IN_OUT_CUBIC,
    UI.ANIM_EASE_IN_QUART,    UI.ANIM_EASE_OUT_QUART,    UI.ANIM_EASE_IN_OUT_QUART,
    UI.ANIM_EASE_IN_QUINT,    UI.ANIM_EASE_OUT_QUINT,    UI.ANIM_EASE_IN_OUT_QUINT,
    UI.ANIM_EASE_IN_SINE,     UI.ANIM_EASE_OUT_SINE,     UI.ANIM_EASE_IN_OUT_SINE,
    UI.ANIM_EASE_IN_EXPO,     UI.ANIM_EASE_OUT_EXPO,     UI.ANIM_EASE_IN_OUT_EXPO,
    UI.ANIM_EASE_IN_CIRC,     UI.ANIM_EASE_OUT_CIRC,     UI.ANIM_EASE_IN_OUT_CIRC,
]
var easeSel = [5] // OutCubic

var pageEasings = func(dt) {
    UI.text("preset easings — sampled via animEvalPreset(type, t):")
    UI.dummy(0, 4)
    UI.combo("preset", easeSel, easeNames)
    UI.dummy(0, 6)

    var origin = UI.getCursorPos()
    var w = 520; var h = 180
    var bg  = UI.color(20, 24, 32, 255)
    var grd = UI.color(60, 70, 82, 255)
    var ln  = UI.color(120, 200, 255, 255)
    var dot = UI.color(255, 200, 80, 255)
    UI.drawRectFilled(origin.x, origin.y, w, h, bg)
    UI.drawRect(origin.x, origin.y, w, h, grd)

    // curve
    var prevX = origin.x; var prevY = origin.y + h
    var i = 1
    while (i <= 80) {
        var u = i / 80.0
        var v = UI.animEvalPreset(easeIds[easeSel[0]], u)
        var px = origin.x + u*w
        var py = origin.y + h - v*h
        UI.drawLine(prevX, prevY, px, py, ln)
        prevX = px; prevY = py
        i++
    }

    // animated marker
    var t = (Time.clock() - clockStart) % 2.0
    var u = t / 2.0
    var v = UI.animEvalPreset(easeIds[easeSel[0]], u)
    UI.drawCircleFilled(origin.x + u*w, origin.y + h - v*h, 6, dot)

    UI.dummy(w, h + 8)
    UI.textDisabled("animTweenFloat also drives the marker on the Tweens tab")
}

// ---------------------------------------------------------------------------
// Page 2: tweens (float / vec2 / color) + policies + rebase
// ---------------------------------------------------------------------------

var tweenTargetX = [40.0]
var tweenPolicy  = [0] // CROSSFADE
var policyNames  = ["Crossfade", "Cut", "Queue"]
var policyIds    = [UI.ANIM_POLICY_CROSSFADE, UI.ANIM_POLICY_CUT, UI.ANIM_POLICY_QUEUE]
var tweenColorA  = [0.2, 0.6, 1.0, 1.0]
var tweenColorB  = [1.0, 0.4, 0.2, 1.0]
var colorToggle  = false
var lastColor    = [0.2, 0.6, 1.0, 1.0]

var pageTweens = func(dt) {
    UI.text("static-target tween — slide the target, watch the marker chase it:")
    UI.dummy(0, 4)
    UI.sliderFloat("target X (px)", tweenTargetX, 0, 480, "%.0f")
    UI.combo("policy", tweenPolicy, policyNames)

    var origin = UI.getCursorPos()
    var w = 520; var h = 60
    var bg  = UI.color(20, 24, 32, 255)
    var trk = UI.color(60, 70, 82, 255)
    var dot = UI.color(120, 200, 255, 255)
    UI.drawRectFilled(origin.x, origin.y, w, h, bg)
    UI.drawLine(origin.x+10, origin.y+h/2, origin.x+w-10, origin.y+h/2, trk)

    var cur = UI.animTweenFloat("tween-marker", 1, tweenTargetX[0], 0.6,
        UI.ANIM_EASE_OUT_CUBIC, policyIds[tweenPolicy[0]], dt)
    UI.drawCircleFilled(origin.x + 20 + cur, origin.y + h/2, 10, dot)
    UI.dummy(w, h + 6)

    UI.dummy(0, 8)
    UI.text("color tween (toggle to flip target):")
    if (UI.button("flip color")) { colorToggle = !colorToggle }
    var target = tweenColorA
    if (colorToggle) { target = tweenColorB }
    lastColor = UI.animTweenColor("tween-color", 1, target, 0.8,
        UI.ANIM_EASE_IN_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE,
        UI.ANIM_COL_OKLAB, dt)
    var origin2 = UI.getCursorPos()
    var sw = UI.color(floor(lastColor[0]*255), floor(lastColor[1]*255),
                      floor(lastColor[2]*255), floor(lastColor[3]*255))
    UI.drawRectFilled(origin2.x, origin2.y, 120, 50, sw)
    UI.dummy(120, 56)
    UI.textDisabled("color space: OKLAB (perceptually uniform)")
}

// ---------------------------------------------------------------------------
// Page 3: waveforms — oscillate / shake / wiggle
// ---------------------------------------------------------------------------

var oscFreq = [1.5]
var oscAmp  = [30.0]
var wigFreq = [3.0]

var pageWaves = func(dt) {
    UI.text("continuous waveforms overlaid on a base value:")
    UI.dummy(0, 4)
    UI.sliderFloat("oscillate freq", oscFreq, 0.1, 5.0, "%.2f")
    UI.sliderFloat("oscillate amp",  oscAmp,  0,   80,  "%.1f")
    UI.sliderFloat("wiggle freq",    wigFreq, 0.1, 8.0, "%.2f")
    UI.dummy(0, 8)

    var origin = UI.getCursorPos()
    var w = 520; var h = 220
    var bg     = UI.color(20, 24, 32, 255)
    var grid   = UI.color(80,80,80,200)
    var label  = UI.color(180,200,220,255)
    UI.drawRectFilled(origin.x, origin.y, w, h, bg)
    UI.drawLine(origin.x, origin.y + h/3,   origin.x+w, origin.y + h/3,   grid)
    UI.drawLine(origin.x, origin.y + 2*h/3, origin.x+w, origin.y + 2*h/3, grid)

    var cx = origin.x + 80
    // oscillate/shake/wiggle return RAW offset/value — we add the base ourselves.
    var oscOff = UI.animOscillate("waves-osc", oscAmp[0], oscFreq[0],
        UI.ANIM_WAVE_SINE, 0, dt)
    UI.drawCircleFilled(cx, origin.y + h/6 + 24 + oscOff, 14, UI.color(120,200,255,255))
    UI.drawText(origin.x + 8, origin.y + 6, label, "oscillate (sine)")

    var shakeOff = UI.animShake("waves-shake", 25, 18, 0.6, dt)
    UI.drawCircleFilled(cx + 160, origin.y + h/2 + 24 + shakeOff, 14, UI.color(255,180,80,255))
    UI.drawText(origin.x + 8, origin.y + h/3 + 6, label, "shake (one-shot)")

    var wigOff = UI.animWiggle("waves-wig", 20, wigFreq[0], dt)
    UI.drawCircleFilled(cx + 320, origin.y + 5*h/6 - 8 + wigOff, 14, UI.color(180,255,140,255))
    UI.drawText(origin.x + 8, origin.y + 2*h/3 + 6, label, "wiggle (smoothed noise)")

    UI.dummy(w, h + 8)
    if (UI.button("trigger shake")) {
        UI.animTriggerShake("waves-shake")
    }
}

// ---------------------------------------------------------------------------
// Page 4: drag feedback with snap points
// ---------------------------------------------------------------------------

var dragState   = "idle"
var dragPos     = [260.0, 120.0]
var dragRelease = [260.0, 120.0]  // pos passed to the first release call; reused while settling

var pageDrag = func(dt) {
    UI.text("click and drag the puck; release to inertia-snap to nearest target:")
    UI.dummy(0, 4)

    var origin = UI.getCursorPos()
    var w = 520; var h = 260
    UI.drawRectFilled(origin.x, origin.y, w, h, UI.color(20, 24, 32, 255))

    var snaps = [[60.0, 60.0], [260.0, 60.0], [460.0, 60.0],
                 [60.0, 200.0], [260.0, 200.0], [460.0, 200.0]]
    var snapCol = UI.color(80,140,180,255)
    var i = 0
    while (i < length(snaps)) {
        var s = snaps[i]
        UI.drawCircle(origin.x + s[0], origin.y + s[1], 14, snapCol)
        i++
    }

    var mp = UI.getMousePos()
    var localX = mp.x - origin.x
    var localY = mp.y - origin.y
    var hovering = (localX >= 0 and localX <= w and localY >= 0 and localY <= h)

    if (hovering and UI.isMouseClicked(0)) {
        var st = UI.animDragBegin("drag", [localX, localY])
        dragPos = st[0]
        dragState = "dragging"
    }
    if (dragState == "dragging" and UI.isMouseDown(0)) {
        var st = UI.animDragUpdate("drag", [localX, localY], dt)
        dragPos = st[0]
    } else { if (dragState == "dragging" and !UI.isMouseDown(0)) {
        // First release call: sets up snap target (closest of `snaps` to release pos)
        // and starts the snap animation. dragRelease is captured so subsequent
        // per-frame release ticks pass the same release pos to upstream.
        dragRelease = [localX, localY]
        var st = UI.animDragRelease("drag", dragRelease,
            [0.0, 0.0], snaps, 0.4, 1.0, UI.ANIM_EASE_OUT_CUBIC, dt)
        dragPos = st[0]
        dragState = "settling"
    } else { if (dragState == "settling") {
        // Subsequent release calls with EMPTY snap opts so upstream
        // doesn't re-arm the snap (which would reset snap_progress=0
        // every frame); this lets it just advance the in-progress
        // snap animation set up by the first release call.
        var st = UI.animDragRelease("drag", dragRelease,
            [0.0, 0.0], null, 0.4, 1.0, UI.ANIM_EASE_OUT_CUBIC, dt)
        dragPos = st[0]
        if (!st[4]) { dragState = "idle" }
    } } }

    UI.drawCircleFilled(origin.x + dragPos[0], origin.y + dragPos[1], 18,
        UI.color(255, 200, 80, 255))

    UI.dummy(w, h + 8)
    UI.textDisabled("state: " + dragState)
}

// ---------------------------------------------------------------------------
// Page 5: motion paths
// ---------------------------------------------------------------------------

var pathBuilt = false

var buildPath = func() {
    UI.animPathBegin("anim-path", [40.0, 140.0])
    UI.animPathCubicTo([120.0, 20.0], [240.0, 20.0], [320.0, 140.0])
    UI.animPathCubicTo([400.0, 260.0], [480.0, 260.0], [520.0, 140.0])
    UI.animPathEnd()
    UI.animPathBuildArcLut("anim-path", 64)
    pathBuilt = true
}

var pagePaths = func(dt) {
    if (!pathBuilt) { buildPath() }
    UI.text("animTweenPath along a built motion path (cubic bezier ribbon):")
    UI.dummy(0, 4)

    var origin = UI.getCursorPos()
    var w = 560; var h = 280
    UI.drawRectFilled(origin.x, origin.y, w, h, UI.color(20, 24, 32, 255))

    // draw path as polyline using parametric eval
    var pathCol = UI.color(80,140,200,255)
    var n = 64; var i = 1
    var prev = UI.animPathEvaluate("anim-path", 0.0)
    while (i <= n) {
        var u = i / (n * 1.0)
        var p = UI.animPathEvaluate("anim-path", u)
        UI.drawLine(origin.x + prev[0], origin.y + prev[1],
                    origin.x + p[0],    origin.y + p[1], pathCol)
        prev = p
        i++
    }

    // travel a marker along the path
    var pos = UI.animTweenPath("path-walker", 1, "anim-path", 2.0,
        UI.ANIM_EASE_IN_OUT_SINE, UI.ANIM_POLICY_CROSSFADE, dt)
    UI.drawCircleFilled(origin.x + pos[0], origin.y + pos[1], 12,
        UI.color(255, 200, 80, 255))

    UI.dummy(w, h + 8)
    UI.textDisabled("path length (parametric): " + str(UI.animPathLength("anim-path")))
}

// ---------------------------------------------------------------------------
// Page 6: gradient + transform interpolation
// ---------------------------------------------------------------------------

var gradBuilt = false
var buildGrads = func() {
    UI.animGradientBegin("grad-a")
    UI.animGradientAddStop(0.0, [0.05, 0.05, 0.20, 1.0])
    UI.animGradientAddStop(0.5, [0.20, 0.60, 1.00, 1.0])
    UI.animGradientAddStop(1.0, [1.00, 0.95, 0.70, 1.0])
    UI.animGradientEnd()

    UI.animGradientBegin("grad-b")
    UI.animGradientAddStop(0.0, [0.30, 0.00, 0.30, 1.0])
    UI.animGradientAddStop(0.5, [1.00, 0.40, 0.10, 1.0])
    UI.animGradientAddStop(1.0, [1.00, 0.90, 0.20, 1.0])
    UI.animGradientEnd()
    gradBuilt = true
}

var gradBlend = [0.0]
var pageColor = func(dt) {
    if (!gradBuilt) { buildGrads() }
    UI.text("gradient lerp (a → b in OKLAB) + animated quad transform:")
    UI.dummy(0, 4)
    UI.sliderFloat("blend", gradBlend, 0, 1, "%.2f")

    var origin = UI.getCursorPos()
    var w = 560; var bandH = 40
    var steps = 80; var i = 0
    // Blend grad-a and grad-b into a transient gradient `grad-mix`, then sample it.
    UI.animGradientLerp("grad-a", "grad-b", gradBlend[0],
        UI.ANIM_COL_OKLAB, "grad-mix")
    while (i < steps) {
        var u = i / (steps * 1.0)
        var c = UI.animGradientSample("grad-mix", u, UI.ANIM_COL_OKLAB)
        var col = UI.color(floor(c[0]*255), floor(c[1]*255), floor(c[2]*255), 255)
        UI.drawRectFilled(origin.x + u*w, origin.y,
            (w / steps) + 1, bandH, col)
        i++
    }
    UI.dummy(w, bandH + 12)

    UI.text("transform tween (animated rotate + scale on a glyph quad):")
    var origin2 = UI.getCursorPos()
    var bw = 560; var bh = 200
    UI.drawRectFilled(origin2.x, origin2.y, bw, bh, UI.color(20, 24, 32, 255))

    var t = (Time.clock() - clockStart)
    var targetRot = sin(t * 0.7) * PI
    var targetScale = 1.0 + 0.5*sin(t * 1.1)
    var xf = UI.animTweenTransform("xform", 1,
        [bw/2.0, bh/2.0, targetScale, targetScale, targetRot],
        0.4, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE,
        UI.ANIM_ROTATION_SHORTEST, dt)
    // xf = [posX, posY, scaleX, scaleY, rotationRad] from animTweenTransform.
    // animTransformQuad does rotate-around-center then translate (no scale),
    // so we bake the tweened scale into the glyph quad's width/height and pass
    // the tweened rotation + position into animTransformQuad.
    var sx = xf[2]; var sy = xf[3]
    var q = UI.animMakeGlyphQuad([0.0, 0.0], 0.0, 80.0*sx, 80.0*sy, 0.0)
    var qt = UI.animTransformQuad(q, [0.0, 0.0], xf[4], [xf[0], xf[1]])
    var c1 = UI.color(120,200,255,255)
    UI.drawLine(origin2.x+qt[0][0], origin2.y+qt[0][1], origin2.x+qt[1][0], origin2.y+qt[1][1], c1)
    UI.drawLine(origin2.x+qt[1][0], origin2.y+qt[1][1], origin2.x+qt[2][0], origin2.y+qt[2][1], c1)
    UI.drawLine(origin2.x+qt[2][0], origin2.y+qt[2][1], origin2.x+qt[3][0], origin2.y+qt[3][1], c1)
    UI.drawLine(origin2.x+qt[3][0], origin2.y+qt[3][1], origin2.x+qt[0][0], origin2.y+qt[0][1], c1)
    UI.dummy(bw, bh + 8)
}

// ---------------------------------------------------------------------------
// Page 7: clips
// ---------------------------------------------------------------------------

var clipBuilt = false
var clipInst  = 0

var buildClip = func() {
    UI.animClipBegin("demo-clip")
    // animClipKeyFloat(channelId, time, value, easeType, bezier4) — bezier4=null for non-bezier eases
    UI.animClipKeyFloat("x", 0.0,  40.0,  UI.ANIM_EASE_LINEAR,       null)
    UI.animClipKeyFloat("x", 1.0,  480.0, UI.ANIM_EASE_OUT_CUBIC,    null)
    UI.animClipKeyFloat("x", 2.0,  40.0,  UI.ANIM_EASE_IN_OUT_CUBIC, null)
    // animClipKeyColor(channelId, time, color, colorSpace, easeType, bezier4)
    UI.animClipKeyColor("col", 0.0, [0.2,0.6,1.0,1.0], UI.ANIM_COL_OKLAB, UI.ANIM_EASE_LINEAR,       null)
    UI.animClipKeyColor("col", 1.0, [1.0,0.4,0.2,1.0], UI.ANIM_COL_OKLAB, UI.ANIM_EASE_OUT_CUBIC,    null)
    UI.animClipKeyColor("col", 2.0, [0.2,0.6,1.0,1.0], UI.ANIM_COL_OKLAB, UI.ANIM_EASE_IN_OUT_CUBIC, null)
    UI.animClipSetLoop(true, UI.ANIM_DIR_NORMAL, -1)
    UI.animClipEnd()
    clipBuilt = true
}

var pageClips = func(dt) {
    if (!clipBuilt) { buildClip() }
    UI.text("keyframed clip — float (x position) and color channels in lockstep:")
    UI.dummy(0, 4)
    // Instance id must be non-zero (0 is upstream's "invalid instance" sentinel),
    // so we pass a stable string id which the binding hashes via ImHashStr.
    if (UI.button("play")) { clipInst = UI.animPlay("demo-clip", "demo-clip/inst") }
    UI.sameLine(0, 8)
    if (UI.button("stop")) { if (clipInst != 0) { UI.animInstanceStop(clipInst) } }
    UI.sameLine(0, 8)
    UI.textDisabled("duration: " + str(UI.animClipDuration("demo-clip")) + "s")
    UI.dummy(0, 6)

    var origin = UI.getCursorPos()
    var w = 560; var h = 100
    UI.drawRectFilled(origin.x, origin.y, w, h, UI.color(20, 24, 32, 255))

    if (clipInst != 0 and UI.animInstanceValid(clipInst)) {
        // animInstanceGetFloat(id, channelId) returns number or null
        // animInstanceGetColor(id, channelId, colorSpace) returns [r,g,b,a] or null
        var x = UI.animInstanceGetFloat(clipInst, "x")
        var c = UI.animInstanceGetColor(clipInst, "col", UI.ANIM_COL_OKLAB)
        if (x == null) { x = 40.0 }
        if (c == null) { c = [0.5, 0.5, 0.5, 1.0] }
        var col = UI.color(floor(c[0]*255), floor(c[1]*255), floor(c[2]*255), 255)
        UI.drawCircleFilled(origin.x + x, origin.y + h/2, 22, col)
    } else {
        UI.textDisabled("press play to launch an instance")
    }
    UI.dummy(w, h + 8)
}

// ---------------------------------------------------------------------------
// Page 8: UI Feel — real-widget micro-interactions
// ---------------------------------------------------------------------------
//
// This page shows what the anim system is actually useful for day-to-day:
// making real UI elements feel responsive. Each demo uses `invisibleButton`
// to claim a hit region, queries `isItemHovered` / `isItemActive`, then
// drives a tween whose value is read back every frame to redraw the widget.

var btnLabels = ["save", "open", "build", "deploy"]
// per-button glow color (tweened toward hover/idle target each frame)
var btnGlow   = [[0.18,0.20,0.26,1.0],
                 [0.18,0.20,0.26,1.0],
                 [0.18,0.20,0.26,1.0],
                 [0.18,0.20,0.26,1.0]]

// hovered card index; -1 if none
var hoveredCard = -1
var cardTitles  = ["Project", "Issues", "Pull Requests"]
var cardBlurbs  = [
    "zym-cli  ·  37 files  ·  last edit 2 min ago",
    "12 open  ·  3 assigned to you  ·  2 due today",
    "5 open  ·  1 awaiting review  ·  builds green",
]

// fade-in details panel
var detailsOpen = false

// animated underline tab strip
var feelTab    = 0
var feelTabs   = ["Overview", "Activity", "Settings", "About"]

var pageUiFeel = func(dt) {
    // ---- Section A: hover-scale + glow buttons ---------------------------
    UI.text("hover-scale + glow buttons — animTweenFloat for scale, animTweenColor for glow")
    UI.dummy(0, 6)

    var bw = 110.0; var bh = 44.0; var bgap = 12.0
    var rowOrigin = UI.getCursorPos()

    var i = 0
    while (i < 4) {
        // Place each button on the same row by drawing into a w×h region;
        // use sameLine() between iterations so ImGui advances horizontally.
        if (i > 0) { UI.sameLine(0, bgap) }
        var bid = "feel/btn/" + str(i)
        UI.invisibleButton(bid, bw, bh)
        var hovered = UI.isItemHovered()
        var active  = UI.isItemActive()
        var rmin = UI.getItemRectMin()
        var rmax = UI.getItemRectMax()
        var cx = (rmin.x + rmax.x) * 0.5
        var cy = (rmin.y + rmax.y) * 0.5

        // tweened scale: 1.0 idle, 1.08 hover, 0.95 press
        var targetScale = 1.0
        if (hovered) { targetScale = 1.08 }
        if (active)  { targetScale = 0.95 }
        var scale = UI.animTweenFloat("feel/btn-scale/"+str(i), 1, targetScale,
            0.18, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

        // tweened glow color: idle dark, hover blue, press orange
        var targetCol = [0.18, 0.20, 0.26, 1.0]
        if (hovered) { targetCol = [0.20, 0.55, 0.95, 1.0] }
        if (active)  { targetCol = [0.95, 0.55, 0.20, 1.0] }
        btnGlow[i] = UI.animTweenColor("feel/btn-col/"+str(i), 1, targetCol,
            0.18, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE,
            UI.ANIM_COL_OKLAB, dt)

        // tiny click-shake offset: animShake returns the live offset every frame;
        // animTriggerShake re-arms the decay envelope. Both share the same id.
        if (UI.isItemClicked()) {
            UI.animTriggerShake("feel/btn-shake/"+str(i))
        }
        var sh = UI.animShake("feel/btn-shake/"+str(i), 6.0, 32.0, 0.40, dt)

        // draw: scaled rounded rect + label
        var hw = bw * 0.5 * scale; var hh = bh * 0.5 * scale
        var x0 = cx - hw + sh; var y0 = cy - hh
        var w  = hw * 2.0;     var h  = hh * 2.0
        var col = UI.color(floor(btnGlow[i][0]*255),
                           floor(btnGlow[i][1]*255),
                           floor(btnGlow[i][2]*255), 255)
        var brd = UI.color(255, 255, 255, 40)
        UI.drawRectFilled(x0, y0, w, h, col)
        UI.drawRect(x0, y0, w, h, brd)
        // crude centered text — drawText is left-baselined, so offset by an
        // approximation of label width × char-width
        var label = btnLabels[i]
        var approxW = length(label) * 7.0
        UI.drawText(cx - approxW*0.5, cy - 7, UI.color(240,242,248,255), label)

        i++
    }
    UI.dummy(0, 16)
    UI.textDisabled("hover to grow + glow, click for a quick shake. all values are tweened, not snapped.")
    UI.dummy(0, 12)

    // ---- Section B: card highlight (sibling dimming) ---------------------
    UI.text("card row — hovered card brightens, siblings dim:")
    UI.dummy(0, 6)

    var cw = 220.0; var ch = 96.0; var cgap = 14.0
    var newHovered = -1
    var ci = 0
    while (ci < 3) {
        if (ci > 0) { UI.sameLine(0, cgap) }
        UI.invisibleButton("feel/card/"+str(ci), cw, ch)
        var hov = UI.isItemHovered()
        if (hov) { newHovered = ci }
        var rmin2 = UI.getItemRectMin()
        var rmax2 = UI.getItemRectMax()

        // alpha tween: 1.0 if this card hovered OR no card hovered; 0.45 if a sibling is hovered
        var targetAlpha = 1.0
        if (hoveredCard >= 0 and hoveredCard != ci) { targetAlpha = 0.45 }
        var alpha = UI.animTweenFloat("feel/card-a/"+str(ci), 1, targetAlpha,
            0.22, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

        // lift tween: 0 idle, -4 hovered (rises a few px)
        var targetLift = 0.0
        if (hov) { targetLift = -4.0 }
        var lift = UI.animTweenFloat("feel/card-l/"+str(ci), 1, targetLift,
            0.18, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

        var a8 = floor(alpha * 255)
        var bg     = UI.color(28, 32, 40, a8)
        var bgHi   = UI.color(40, 48, 64, a8)
        var border = UI.color(120, 180, 255, a8)
        var x0 = rmin2.x; var y0 = rmin2.y + lift; var w = cw; var h = ch
        if (hov) {
            UI.drawRectFilled(x0, y0, w, h, bgHi)
            UI.drawRect       (x0, y0, w, h, border)
        } else {
            UI.drawRectFilled(x0, y0, w, h, bg)
            UI.drawRect       (x0, y0, w, h, UI.color(70, 80, 96, a8))
        }
        UI.drawText(x0 + 12, y0 + 12, UI.color(240, 242, 248, a8), cardTitles[ci])
        UI.drawText(x0 + 12, y0 + 38, UI.color(180, 188, 204, a8), cardBlurbs[ci])
        ci++
    }
    hoveredCard = newHovered
    UI.dummy(0, 16)

    // ---- Section C: fade-in details on hover -----------------------------
    UI.text("expandable details — clicking the header tweens an info block in/out:")
    UI.dummy(0, 6)

    UI.invisibleButton("feel/expand/hdr", 360, 28)
    var hdrHov = UI.isItemHovered()
    var hdrMin = UI.getItemRectMin()
    if (UI.isItemClicked()) { detailsOpen = !detailsOpen }

    var hdrBg = UI.color(36, 42, 54, 255)
    if (hdrHov) { hdrBg = UI.color(50, 58, 76, 255) }
    UI.drawRectFilled(hdrMin.x, hdrMin.y, 360, 28, hdrBg)
    var caret = "▶"
    if (detailsOpen) { caret = "▼" }
    UI.drawText(hdrMin.x + 10, hdrMin.y + 6, UI.color(240,242,248,255),
        caret + "   build details")

    // alpha tween 0..1
    var detailTarget = 0.0
    if (detailsOpen) { detailTarget = 1.0 }
    var detailA = UI.animTweenFloat("feel/details-a", 1, detailTarget,
        0.28, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
    // height tween 0..72
    var detailH = UI.animTweenFloat("feel/details-h", 1, detailTarget * 72.0,
        0.28, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

    if (detailH > 0.5) {
        var dx = hdrMin.x; var dy = hdrMin.y + 32
        var a8 = floor(detailA * 255)
        UI.drawRectFilled(dx, dy, 360, detailH, UI.color(22, 26, 34, a8))
        UI.drawRect       (dx, dy, 360, detailH, UI.color(70, 80, 96, a8))
        if (detailA > 0.05) {
            UI.drawText(dx + 12, dy + 10, UI.color(200,210,220, a8), "target:    zym (Release)")
            UI.drawText(dx + 12, dy + 30, UI.color(200,210,220, a8), "compiler:  clang 18.1.3")
            UI.drawText(dx + 12, dy + 50, UI.color(200,210,220, a8), "duration:  4.21s  ·  warnings: 0")
        }
    }
    UI.dummy(360, 32 + 76)

    // ---- Section D: animated underline tab strip -------------------------
    UI.text("tab strip with a tweened underline that slides between tabs:")
    UI.dummy(0, 6)

    var tw = 110.0; var th = 28.0
    var stripOrigin = UI.getCursorPos()
    var ti = 0
    while (ti < 4) {
        if (ti > 0) { UI.sameLine(0, 0) }
        UI.invisibleButton("feel/tab/"+str(ti), tw, th)
        if (UI.isItemClicked()) { feelTab = ti }
        var trmin = UI.getItemRectMin()
        var trmax = UI.getItemRectMax()
        var thov = UI.isItemHovered()

        var tcol = UI.color(160, 168, 184, 255)
        if (feelTab == ti) { tcol = UI.color(240, 242, 248, 255) }
        if (thov and feelTab != ti) { tcol = UI.color(210, 220, 235, 255) }
        var lblW = length(feelTabs[ti]) * 7.0
        var cx = (trmin.x + trmax.x) * 0.5
        var cy = (trmin.y + trmax.y) * 0.5
        UI.drawText(cx - lblW*0.5, cy - 7, tcol, feelTabs[ti])
        ti++
    }
    // separator line under all tabs
    UI.drawLine(stripOrigin.x, stripOrigin.y + th,
                stripOrigin.x + tw*4, stripOrigin.y + th,
                UI.color(70, 80, 96, 255))

    // tween underline X and width toward the selected tab
    var targetUx = stripOrigin.x + feelTab * tw
    var underlineX = UI.animTweenFloat("feel/underline-x", 1, targetUx,
        0.28, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
    UI.drawRectFilled(underlineX, stripOrigin.y + th - 2,
                      tw, 2,
                      UI.color(80, 170, 255, 255))

    UI.dummy(tw*4, th + 8)
    UI.textDisabled("click any tab — the underline tweens to follow.")
}

// ---------------------------------------------------------------------------
// Main loop
// ---------------------------------------------------------------------------

var done = false

while (!win.shouldClose() and !done) {
    var e = SDL.pollEvent()
    while (e != null) {
        if (e.type == "quit") { done = true }
        e = SDL.pollEvent()
    }

    var nowT = Time.clock() - clockStart
    var dt = nowT - lastT
    if (dt < 0.0) { dt = 0.0 }
    if (dt > 0.1) { dt = 0.1 }
    lastT = nowT

    UI.frame(win, func() {
        frame++
        var size = win.getSize()
        UI.setNextWindowPos(0, 0)
        UI.setNextWindowSize(size.w, size.h)

        var wf = UI.WINDOW_NO_TITLE_BAR + UI.WINDOW_NO_RESIZE
               + UI.WINDOW_NO_MOVE      + UI.WINDOW_NO_COLLAPSE
               + UI.WINDOW_NO_BRING_TO_FRONT_ON_FOCUS
               + UI.WINDOW_NO_SAVED_SETTINGS

        UI.window("root", wf, func() {
            UI.text("◆  ZYM UI.anim* SHOWCASE")
            UI.sameLine(0, 20); UI.textDisabled("ImAnim v1.0")
            UI.sameLine(size.w - 180)
            UI.textDisabled(str(floor(UI.framerate()))+" fps  ·  frame "+str(frame))
            UI.dummy(0, 6)

            UI.tabBar("anim-nav", func() {
                UI.tabItem("Easings",   func() { pageEasings(dt) })
                UI.tabItem("Tweens",    func() { pageTweens(dt)  })
                UI.tabItem("Waveforms", func() { pageWaves(dt)   })
                UI.tabItem("Drag",      func() { pageDrag(dt)    })
                UI.tabItem("Paths",     func() { pagePaths(dt)   })
                UI.tabItem("Color",     func() { pageColor(dt)   })
                UI.tabItem("Clips",     func() { pageClips(dt)   })
                UI.tabItem("UI Feel",   func() { pageUiFeel(dt)  })
            })
        })
    })
}

win.free()
