// Slice 1 PR 2c — style stacks + fonts demo (future/gui.md §1.3).
//
// Renders the same little widget panel three ways side-by-side:
//   * left   — default ImGui style.
//   * middle — accent palette via `UI.withStyleColor`.
//   * right  — accent palette + tweaked spacing/rounding via
//              `UI.withStyleVar` nested inside the color scope.
//
// A bottom panel shows `UI.withFont` rendering text with the default
// font (which lives in the lazy-created context's atlas). The
// preset `UI.themes.*` and `UI.applyTheme` helpers are deferred to a
// later PR; this example exercises only the scoped style stack APIs
// shipped in PR 2c.
//
// Manual run only — needs a display, not in runAll.sh.
//
// Usage:
//   zym run examples/gui/theming.zym

var win = SDL.createWindow("zym ui theming", 760, 480, {
    resizable: true,
})
if (win == null) {
    print("createWindow failed: %v", SDL.lastError())
    return
}

// A tiny reusable widget panel — same shape each time, only the
// surrounding style scope changes. Demonstrates the "callback is a
// reusability layer" property called out in §1.0.
var panel = func(label) {
    UI.text(label)
    if (UI.button("Save##" + label)) { print("save: %v", label) }
    UI.sameLine()
    if (UI.button("Cancel##" + label)) { print("cancel: %v", label) }
    var enabled = [true]
    UI.checkbox("Enabled##" + label, enabled)
    var slider = [0.5]
    UI.sliderFloat("Slider##" + label, slider, 0.0, 1.0)
}

// Accent palette — applied via `UI.withStyleColor`. Map keys are the
// ImGui color slot names (drop the `ImGuiCol_` prefix); values are
// `[r, g, b]` or `[r, g, b, a]` lists of floats in 0..1.
var accent = {
    Button:        [0.20, 0.55, 0.85, 1.0],
    ButtonHovered: [0.30, 0.70, 0.95, 1.0],
    ButtonActive:  [0.10, 0.40, 0.75, 1.0],
    FrameBg:       [0.18, 0.20, 0.28, 1.0],
    FrameBgHovered:[0.25, 0.30, 0.40, 1.0],
    CheckMark:     [0.95, 0.80, 0.20, 1.0],
    SliderGrab:    [0.95, 0.80, 0.20, 1.0],
    Text:          [0.95, 0.97, 1.0,  1.0],
}

// Spacing/rounding tweak — applied via `UI.withStyleVar`. Scalar vars
// map to numbers; ImVec2 vars (padding, spacing, alignment) map to
// `[x, y]` lists.
var spacing = {
    FrameRounding:  6.0,
    FramePadding:   [8, 6],
    ItemSpacing:    [10, 8],
    GrabRounding:   6.0,
    WindowRounding: 8.0,
}

// `UI.defaultFont()` must be called inside a frame (it needs the
// per-window ImGui context). We grab it once on the first frame and
// reuse the handle thereafter.
var bigFont = null

var done = false
while (!win.shouldClose() and !done) {
    var e = SDL.pollEvent()
    while (e != null) {
        if (e.type == "quit") { done = true }
        e = SDL.pollEvent()
    }

    UI.frame(win, func() {
        if (bigFont == null) {
            bigFont = UI.defaultFont()
        }

        UI.window("theming", func() {
            UI.text("Three flavours of the same panel:")
            UI.separator()

            // left — default style.
            UI.child("left", { w: 220, h: 220, border: true }, func() {
                UI.text("default")
                UI.separator()
                panel("default")
            })
            UI.sameLine()

            // middle — accent palette only.
            UI.child("mid", { w: 220, h: 220, border: true }, func() {
                UI.withStyleColor(accent, func() {
                    UI.text("accent")
                    UI.separator()
                    panel("accent")
                })
            })
            UI.sameLine()

            // right — accent palette + spacing/rounding nested.
            UI.child("right", { w: 220, h: 220, border: true }, func() {
                UI.withStyleColor(accent, func() {
                    UI.withStyleVar(spacing, func() {
                        UI.text("accent + spacing")
                        UI.separator()
                        panel("spaced")
                    })
                })
            })

            UI.separator()
            UI.text("Font scope:")
            UI.withFont(bigFont, func() {
                UI.text("UI.withFont wraps PushFont/PopFont.")
                UI.text("Default font (ProggyClean) — load a TTF via")
                UI.text("UI.loadFont(path, sizePx) for nicer glyphs.")
            })
            UI.text("Back to the surrounding font here.")
        })
    })
}

win.free()
