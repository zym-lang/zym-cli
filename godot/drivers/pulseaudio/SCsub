#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

# zym: when pulseaudio is disabled, audio_driver_pulseaudio.cpp's
# `servers/audio/audio_server.h` include can no longer be resolved (servers/*
# has been removed). Skip the .cpp (and the so_wrap shim) entirely when the
# feature is off.
if "pulseaudio" in env and env["pulseaudio"]:
    if env["use_sowrap"]:
        env.add_source_files(env.drivers_sources, "pulse-so_wrap.c")
    env.add_source_files(env.drivers_sources, "*.cpp")
