var pageData = func() {
    var ws = win.getSize()
    var w3 = (ws.w - 100) / 3

    UI.child("plots", { w:0, h:190, border:false }, func() {
        UI.child("s1", { w:w3, h:180, border:true }, func() {
            secHeader("Signal A", "sine + noise")
            UI.plotLines("##sa", signal1, "", -2, 2)
        })
        UI.sameLine()
        UI.child("s2", { w:w3, h:180, border:true }, func() {
            secHeader("Signal B", "cosine")
            UI.plotLines("##sb", signal2, "", -2, 2)
        })
        UI.sameLine()
        UI.child("s3", { w:0, h:180, border:true }, func() {
            secHeader("Signal C", "histogram")
            UI.plotHistogram("##sc", signal3, "", 0, 3)
        })
    })

    UI.dummy(0,6)
    secHeader("Data table", "sortable · filterable · drag rows to reorder")

    UI.setNextItemWidth(200); UI.inputText("##ts", tableSearch)
    UI.sameLine(); UI.setNextItemWidth(130); UI.combo("##tf", tableFilter, tableTypes)
    UI.sameLine()
    if (UI.button("A→Z")) { tableSort[0]=0; tableSortDir[0]=1; sortTable() }
    UI.sameLine()
    if (UI.button("Z→A")) { tableSort[0]=0; tableSortDir[0]=-1; sortTable() }
    UI.sameLine()
    if (UI.button("Score↓")) { tableSort[0]=4; tableSortDir[0]=-1; sortTable() }
    UI.dummy(0,4)

    var tflags = UI.TABLE_RESIZABLE + UI.TABLE_REORDERABLE + UI.TABLE_HIDEABLE
               + UI.TABLE_SORTABLE  + UI.TABLE_ROW_BG      + UI.TABLE_BORDERS_INNER_H
               + UI.TABLE_BORDERS_OUTER_V + UI.TABLE_SIZING_STRETCH_PROP

    UI.table("dtbl", 5, tflags, func() {
        UI.tableSetupColumn("Name"); UI.tableSetupColumn("Type")
        UI.tableSetupColumn("Size"); UI.tableSetupColumn("Status"); UI.tableSetupColumn("Score")
        UI.tableHeadersRow()

        var specs = UI.tableGetSortSpecs()
        if (specs != null and length(specs) > 0) {
            var s = specs[0]; tableSort[0] = s.column
            tableSortDir[0] = s.direction == "asc" ? 1 : -1; sortTable()
        }

        var q = toLowerCase(tableSearch.toUtf8()); var i = 0
        while (i < length(tableData)) {
            var row = tableData[i]
            var typeOk = tableFilter[0]==0 or row.type==tableTypes[tableFilter[0]]
            var nameOk = q=="" or contains(toLowerCase(row.name+" "+row.type),q)
            if (typeOk and nameOk) {
                UI.tableNextRow(); UI.tableNextColumn()
                UI.id(i, func() {
                    if (UI.selectable(row.name, tableSelected==i)) { tableSelected = i }
                    if (UI.beginDragDropSource()) {
                        UI.setDragDropPayload("ROW", str(i))
                        UI.text("⠿  "+row.name); UI.textDisabled(row.type+" · "+row.status)
                        UI.endDragDropSource()
                    }
                    if (UI.beginDragDropTarget()) {
                        var p = UI.acceptDragDropPayload("ROW")
                        if (p != null) { dndDragIdx = num(p); dndDropIdx = i }
                        UI.endDragDropTarget()
                    }
                })
                UI.tableNextColumn(); UI.textDisabled(row.type)
                UI.tableNextColumn(); UI.text(str(row.size)+" kb")
                UI.tableNextColumn(); UI.textColored(statusColor(row.status), row.status)
                UI.tableNextColumn()
                var sc = row.score
                var scCol = [0.85,0.32,0.32,1]
                if (sc >= 50) { scCol = [0.90,0.65,0.20,1] }
                if (sc >= 75) { scCol = [0.30,0.80,0.50,1] }
                UI.textColored(scCol, str(sc))
            }
            i++
        }
    })

    if (dndDragIdx >= 0 and dndDropIdx >= 0 and dndDragIdx != dndDropIdx) {
        var tmp = tableData[dndDragIdx]; tableData[dndDragIdx] = tableData[dndDropIdx]; tableData[dndDropIdx] = tmp
        dndDragIdx = -1; dndDropIdx = -1
    }

    if (tableSelected >= 0 and tableSelected < length(tableData)) {
        UI.dummy(0,6); var sel = tableData[tableSelected]
        UI.child("rdet", { w:0, h:80, border:true }, func() {
            secHeader("Selected: "+sel.name, sel.type+" · "+sel.status)
            UI.progressBar(sel.score/100.0, 300, 0, "score: "+str(sel.score)+"%")
        })
    }
}

// ---------------------------------------------------------------------------
// Page: Drawing  (uses DrawList API throughout)
// ---------------------------------------------------------------------------

var pageDrawing = func() {
    var ws = win.getSize()

    UI.child("draw-ctrl", { w:260, h:0, border:true }, func() {
        secHeader("Controls", "")
        UI.combo("Mode", drawMode, drawModes)
        UI.dummy(0,6)
        UI.colorEdit("Color A", drawColor1)
        UI.colorEdit("Color B", drawColor2)
        UI.dummy(0,6)
        UI.sliderFloat("Param 1", drawParam1, 0.5, 8.0, "%.1f")
        UI.sliderFloat("Param 2", drawParam2, 0.5, 8.0, "%.1f")
        UI.sliderFloat("Param 3", drawParam3, 0.0, 1.0, "%.2f")
        UI.sliderFloat("Thickness", drawThick, 0.5, 6.0, "%.1f")
        if (drawMode[0] == 5) {
            UI.sliderFloat("Speed", drawSpeed, 0.0, 2.0, "%.2f")
        }
        UI.dummy(0,8)
        UI.textDisabled("mode: "+drawModes[drawMode[0]])
        UI.dummy(0,4); UI.separator(); UI.dummy(0,4)
        UI.textDisabled("performance")
        UI.plotLines("##fps", fps_hist, str(floor(fps_hist[length(fps_hist)-1]))+" fps", 0, 0)
    })

    UI.sameLine()

    UI.child("draw-canvas", { w:0, h:0, border:true }, func() {
        var p   = UI.getCursorPos()
        var cw  = UI.getWindowWidth()  - 20
        var ch  = UI.getWindowHeight() - 20
        var cx  = p.x + cw/2; var cy = p.y + ch/2
        var dl  = UI.drawList()
        var t   = drawTime
        var p1  = drawParam1[0]; var p2 = drawParam2[0]; var p3 = drawParam3[0]
        var th  = drawThick[0]
        var c1  = packColor(drawColor1); var c2 = packColor(drawColor2)
        var mode = drawMode[0]

        // Background
        dl.addRectFilled(p.x, p.y, cw, ch, packColor([0.04,0.05,0.07,1]), 0.0, UI.DRAW_NONE)

        switch (mode) {
            case 0: {
                // Bezier ribbons
                var steps = 12; var i = 0
                while (i < steps) {
                    var frac = i / steps
                    var off  = frac * ch * 0.8
                    var hue  = (frac + t*0.05) % 1.0
                    var col  = packColor(hsvToRgb(hue, 0.8, 0.9))
                    var wave = sin(frac * PI2 * p1 + t * p2) * ch * 0.15 * p3
                    dl.addBezierCubic(
                        p.x,           p.y + off + wave,
                        p.x + cw*0.33, p.y + off - wave*1.5,
                        p.x + cw*0.66, p.y + off + wave*1.5,
                        p.x + cw,      p.y + off - wave,
                        col, th
                    )
                    i++
                }
                break
            }
            case 1: {
                // Lissajous
                var pts = []; var steps = 300; var si2 = 0
                while (si2 <= steps) {
                    var ang = si2 / steps * PI2
                    push(pts, cx + cos(ang*p1 + t) * (cw*0.42))
                    push(pts, cy + sin(ang*p2 + t*0.7) * (ch*0.42))
                    si2++
                }
                var i2 = 0
                while (i2 < length(pts) - 2) {
                    var hue = (i2/length(pts) + t*0.08) % 1.0
                    dl.addLine(pts[i2], pts[i2+1], pts[i2+2], pts[i2+3], packColor(hsvToRgb(hue,0.85,0.95)), th)
                    i2 = i2 + 2
                }
                break
            }
            case 2: {
                // Spiral
                var steps = 800; var spx = cx; var spy = cy; var si3 = 0
                while (si3 <= steps) {
                    var r3 = si3 * 0.65 * p3
                    var ang = si3 * 0.04 * p1
                    var nx = cx + cos(ang + t*p2*0.3) * r3
                    var ny = cy + sin(ang + t*p2*0.3) * r3
                    if (si3 > 0) {
                        dl.addLine(spx, spy, nx, ny, packColor(hsvToRgb((si3/steps+t*0.05)%1.0,0.9,0.95)), th)
                    }
                    spx = nx; spy = ny; si3++
                }
                break
            }
            case 3: {
                // Rose curve
                dl.pathClear()
                var steps = 600; var si4 = 0
                while (si4 <= steps) {
                    var theta = si4/steps * PI2 * floor(p2)
                    var r4 = cos(p1/p2 * theta + t*0.2) * min(cw,ch) * 0.42
                    dl.pathLineTo(cx + cos(theta)*r4, cy + sin(theta)*r4)
                    si4++
                }
                dl.pathStroke(c1, true, th, UI.DRAW_NONE)
                dl.pathClear(); si4 = 0
                while (si4 <= steps) {
                    var theta = si4/steps*PI2*floor(p1) + PI/p2
                    var r4 = cos(p2/p1*theta + t*0.3) * min(cw,ch) * 0.28
                    dl.pathLineTo(cx + cos(theta)*r4, cy + sin(theta)*r4)
                    si4++
                }
                dl.pathStroke(c2, true, th*0.7, UI.DRAW_NONE)
                break
            }
            case 4: {
                // Grid wave
                var cols = floor(p1*4)+5; var rows = floor(p2*3)+4; var gi = 0
                while (gi <= cols) {
                    var gx = p.x + (gi/cols)*cw; var gj = 0
                    while (gj <= rows) {
                        var gy = p.y + (gj/rows)*ch
                        var dx = sin(gj*0.5 + t*p1) * 14*p3
                        var dy = cos(gi*0.5 + t*p2) * 14*p3
                        if (gj > 0) {
                            var pgy = p.y + ((gj-1)/rows)*ch
                            dl.addLine(gx+dx, pgy+sin((gj-1)*0.5+t*p1)*14*p3, gx+dx, gy+dy, c1, th*0.7)
                        }
                        if (gi > 0) {
                            var pgx = p.x + ((gi-1)/cols)*cw
                            dl.addLine(pgx+cos((gi-1)*0.5+t*p2)*14*p3, gy+dy, gx+dx, gy+dy, c2, th*0.7)
                        }
                        gj++
                    }
                    gi++
                }
                break
            }
            case 5: {
                // Particles
                var dt = 1.0 / 60.0
                var spd = drawSpeed[0]; var pri = 0
                while (pri < length(particles)) {
                    var pt = particles[pri]
                    pt.x = pt.x + pt.vx*dt*60*spd; pt.y = pt.y + pt.vy*dt*60*spd
                    if (pt.x<0 or pt.x>1) { pt.vx=-pt.vx; pt.x=pt.x<0?0:1 }
                    if (pt.y<0 or pt.y>1) { pt.vy=-pt.vy; pt.y=pt.y<0?0:1 }
                    pt.hue = (pt.hue + 0.001) % 1.0
                    var sx = p.x+pt.x*cw; var sy = p.y+pt.y*ch
                    dl.addCircleFilled(sx, sy, pt.r*cw, packColor(hsvToRgb(pt.hue,0.8,0.95)), 0)
                    var prj = pri+1
                    while (prj < length(particles)) {
                        var pt2 = particles[prj]
                        var ddx = pt.x-pt2.x; var ddy = pt.y-pt2.y
                        var dist = sqrt(ddx*ddx+ddy*ddy)
                        if (dist < 0.12) {
                            dl.addLine(sx, sy, p.x+pt2.x*cw, p.y+pt2.y*ch,
                                packColor([pt.hue,0.8,0.9,(0.12-dist)/0.12*0.5]), th*0.5)
                        }
                        prj++
                    }
                    particles[pri] = pt; pri++
                }
                break
            }
            case 6: {
                // Tunnel
                var rings = 18; var ri = 0
                while (ri < rings) {
                    var frac = ri/rings
                    var r6 = (1.0-frac) * min(cw,ch) * 0.48
                    var rot = t*p1*(1.0-frac)*0.5 + frac*PI/p2
                    var sides = floor(p2*2)+3
                    var hue = (frac + t*0.03) % 1.0
                    dl.addNgon(cx, cy, r6, packColor(hsvToRgb(hue,0.8,0.9)), sides, th)
                    if (ri % 3 == 0) {
                        var si5 = 0
                        while (si5 < sides) {
                            var ang = rot + si5/sides * PI2
                            dl.addLine(cx, cy, cx+cos(ang)*r6, cy+sin(ang)*r6,
                                packColor(hsvToRgb(hue,0.6,0.4)), th*0.4)
                            si5++
                        }
                    }
                    ri++
                }
                break
            }
            default: {
                // Voronoi
                var seeds = floor(p2 * 3) + 4
                var gsize = floor(p1 * 4) + 4
                var seedPts = []; var vi = 0
                while (vi < seeds) {
                    var ang = vi/seeds*PI2 + t*0.1*(vi%3==0?1:-1)
                    var r7 = min(cw,ch)*0.3 + sin(t*0.3+vi)*min(cw,ch)*0.1
                    push(seedPts, { x:cx+cos(ang)*r7, y:cy+sin(ang)*r7, hue:vi/seeds })
                    vi++
                }
                var gxi = 0
                while (gxi*gsize < cw) {
                    var gyi = 0
                    while (gyi*gsize < ch) {
                        var sx = p.x+gxi*gsize+gsize/2; var sy = p.y+gyi*gsize+gsize/2
                        var minDist = 99999.0; var minHue = 0.0; var si6 = 0
                        while (si6 < seeds) {
                            var ddx = sx-seedPts[si6].x; var ddy = sy-seedPts[si6].y
                            var d = ddx*ddx+ddy*ddy
                            if (d < minDist) { minDist = d; minHue = seedPts[si6].hue }
                            si6++
                        }
                        var intensity = 1.0 - (minDist / (min(cw,ch)*0.35 * min(cw,ch)*0.35))
                        if (intensity < 0) { intensity = 0 }
                        dl.addRectFilled(sx-gsize/2, sy-gsize/2, gsize, gsize,
                            packColor(hsvToRgb((minHue+t*0.05)%1.0,0.7,intensity*0.9)), 0.0, UI.DRAW_NONE)
                        gyi++
                    }
                    gxi++
                }
                var si7 = 0
                while (si7 < seeds) {
                    dl.addCircleFilled(seedPts[si7].x, seedPts[si7].y, 4, packColor([1,1,1,0.8]), 0)
                    si7++
                }
                break
            }
        }

        // Crosshair
        dl.addLine(cx-8, cy, cx+8, cy, packColor([1,1,1,0.12]), 1.0)
        dl.addLine(cx, cy-8, cx, cy+8, packColor([1,1,1,0.12]), 1.0)

        UI.dummy(cw, ch)
    })
}

// ---------------------------------------------------------------------------
// Page: Custom Widgets
// ---------------------------------------------------------------------------

var pageCustom = func() {
    var ws  = win.getSize()
    var hw  = (ws.w - 80) / 2

    UI.child("cw-left", { w: hw, h: 0, border: false }, func() {

        secHeader("Knob", "click-drag to adjust value")
        UI.child("knob-area", { w: 0, h: 140, border: true }, func() {
            var dl    = UI.drawList()
            var lp    = UI.getCursorPos()
            var wp    = UI.getWindowPos()
            var p     = UI.getCursorPos()
            var cx2   = p.x + 60; var cy2 = p.y + 60
            var r     = 45.0
            var vmin  = 0.0; var vmax = 1.0
            var v     = knobVal[0]
            var startAng = PI * 0.75; var endAng = PI2 + PI * 0.25
            var valAng   = startAng + (v-vmin)/(vmax-vmin)*(endAng-startAng)
            var ac = accent[0]

            // Track
            dl.pathArcTo(cx2, cy2, r, startAng, endAng, 48)
            dl.pathStroke(packColor([1,1,1,0.08]), false, 6.0, UI.DRAW_NONE)
            // Fill
            dl.pathArcTo(cx2, cy2, r, startAng, valAng, 48)
            dl.pathStroke(packColor(ac), false, 6.0, UI.DRAW_NONE)
            // Center circle
            dl.addCircleFilled(cx2, cy2, r-10, packColor([0.12,0.14,0.18,1]), 0)
            dl.addCircle(cx2, cy2, r-10, packColor([1,1,1,0.06]), 0, 1.0)
            // Indicator line
            dl.addLine(cx2, cy2,
                cx2 + cos(valAng)*(r-12),
                cy2 + sin(valAng)*(r-12),
                packColor(ac), 2.0)
            // Value text
            var valStr = str(floor(v*100))+"%"
            var ts = UI.calcTextSize(valStr)
            dl.addText(cx2 - ts.x/2, cy2 - ts.y/2, packColor([0.93,0.95,0.98,1]), valStr)

            UI.setCursorPos(15, 15)
            UI.invisibleButton("knob", 90, 90)
            if (UI.isItemActive()) {
                var delta = UI.getMouseDragDelta(0)
                knobVal[0] = knobVal[0] - delta.y * 0.005
                if (knobVal[0] < 0) { knobVal[0] = 0 }
                if (knobVal[0] > 1) { knobVal[0] = 1 }
                UI.resetMouseDragDelta(0)
            }
            if (UI.isItemHovered()) { UI.tooltip("Drag up/down to adjust") }

            UI.setCursorPos(120, 20)
            UI.text("Value: " + str(floor(knobVal[0]*100)) + "%")
            UI.setCursorPos(120, 44)
            UI.sliderFloat("##knobsl", knobVal, 0.0, 1.0)
            UI.setCursorPos(4, 125)
            UI.dummy(0, 0)
        })

        UI.dummy(0,8)
        secHeader("Toggle switch", "click to toggle")
        UI.child("toggle-area", { w:0, h:60, border:true }, func() {
            var dl  = UI.drawList()
            var p   = UI.getCursorPos()
            var tw  = 52.0; var th2 = 26.0; var r2 = th2/2
            var on  = toggleVal[0]
            var bgCol = on ? packColor(accent[0]) : packColor([1,1,1,0.12])
            var kx  = on ? p.x+tw-r2 : p.x+r2

            dl.addRectFilled(p.x, p.y+8, tw, th2, bgCol, r2, UI.DRAW_ROUND_CORNERS_ALL)
            dl.addCircleFilled(kx, p.y+8+r2, r2-3, packColor([1,1,1,0.95]), 0)

            UI.setCursorPos(0, 8)
            UI.invisibleButton("toggle", tw, th2)
            if (UI.isItemClicked()) { toggleVal[0] = !toggleVal[0] }

            UI.setCursorPos(tw+12, 14)
            UI.text(on ? "ON" : "OFF")
            UI.setCursorPos(tw+60, 14)
            UI.textDisabled("(click the switch)")
            UI.setCursorPos(0, th2+12)
            UI.dummy(0, 0)
        })

        UI.dummy(0,8)
        secHeader("Radial progress", "")
        UI.child("radial-area", { w:0, h:140, border:true }, func() {
            var dl  = UI.drawList()
            var p   = UI.getCursorPos()
            var cx3 = p.x+65; var cy3 = p.y+65; var r3 = 50.0
            var v3  = radialProg[0]
            var ac  = accent[0]

            // Background ring
            dl.pathArcTo(cx3, cy3, r3, -PI/2, -PI/2+PI2, 64)
            dl.pathStroke(packColor([1,1,1,0.06]), false, 10.0, UI.DRAW_NONE)
            // Progress arc
            dl.pathArcTo(cx3, cy3, r3, -PI/2, -PI/2+PI2*v3, 64)
            dl.pathStroke(packColor(ac), false, 10.0, UI.DRAW_NONE)
            // Inner circle
            dl.addCircleFilled(cx3, cy3, r3-14, packColor([0.09,0.10,0.13,1]), 0)
            // Percentage text
            var pStr = str(floor(v3*100))+"%"
            var ts2  = UI.calcTextSize(pStr)
            dl.addText(cx3-ts2.x/2, cy3-ts2.y/2, packColor([0.93,0.95,0.98,1]), pStr)
            // End cap dot
            var endAng = -PI/2 + PI2*v3
            dl.addCircleFilled(cx3+cos(endAng)*r3, cy3+sin(endAng)*r3, 6,
                packColor(ac), 0)

            UI.setCursorPos(145, 30)
            UI.text("Completion")
            UI.setCursorPos(145, 54)
            UI.sliderFloat("##rp", radialProg, 0.0, 1.0)
            UI.setCursorPos(4, 132)
            UI.dummy(0, 0)
        })

        UI.dummy(0,8)
        secHeader("Gradient cards", "addRectFilledMultiColor")
        UI.child("grad-area", { w:0, h:110, border:false }, func() {
            var dl = UI.drawList()
            var p   = UI.getCursorPos()
            var cw2 = (UI.getWindowWidth()-40)/2; var ch2 = 90.0

            // Card 1
            dl.addRectFilledMultiColor(p.x, p.y, cw2, ch2,
                packColor(gradCard1), packColor(gradCard2),
                packColor(gradCard2), packColor(gradCard1))
            dl.addRect(p.x, p.y, cw2, ch2, packColor([1,1,1,0.08]), 6.0, 1.0, UI.DRAW_ROUND_CORNERS_ALL)
            dl.addText(p.x+12, p.y+36, packColor([1,1,1,0.9]), "Gradient A→B")

            // Card 2
            var x2 = p.x + cw2 + 10
            dl.addRectFilledMultiColor(x2, p.y, cw2, ch2,
                packColor(gradCard3), packColor(gradCard3),
                packColor(gradCard4), packColor(gradCard4))
            dl.addRect(x2, p.y, cw2, ch2, packColor([1,1,1,0.08]), 6.0, 1.0, UI.DRAW_ROUND_CORNERS_ALL)
            dl.addText(x2+12, p.y+36, packColor([1,1,1,0.9]), "Gradient C→D")

            UI.dummy(0, ch2+4)
        })
    })

    UI.sameLine()

    UI.child("cw-right", { w:0, h:0, border:false }, func() {

        secHeader("Radar / spider chart", "")
        UI.child("radar-area", { w:0, h:240, border:true }, func() {
            var dl   = UI.drawList()
            var p   = UI.getCursorPos()
            var cw3  = UI.getWindowWidth()-20
            var cx4  = p.x + cw3/2; var cy4 = p.y + 110
            var r4   = 90.0; var sides = length(radarData)

            // Grid rings
            var ring = 0
            while (ring < 4) {
                var rf = (ring+1)/4 * r4
                var pts4 = []
                var si8 = 0
                while (si8 < sides) {
                    var ang = si8/sides*PI2 - PI/2
                    push(pts4, cx4+cos(ang)*rf); push(pts4, cy4+sin(ang)*rf)
                    si8++
                }
                dl.addPolyline(pts4, packColor([1,1,1,0.06]), true, 1.0, UI.DRAW_NONE)
                ring++
            }
            // Spokes + labels
            var si9 = 0
            while (si9 < sides) {
                var ang = si9/sides*PI2 - PI/2
                var lx = cx4+cos(ang)*r4; var ly = cy4+sin(ang)*r4
                dl.addLine(cx4, cy4, lx, ly, packColor([1,1,1,0.08]), 1.0)
                var label = radarLabels[si9]
                var ts3   = UI.calcTextSize(label)
                var lx2 = cx4+cos(ang)*(r4+14)-ts3.x/2
                var ly2 = cy4+sin(ang)*(r4+14)-ts3.y/2
                dl.addText(lx2, ly2, packColor([0.48,0.52,0.60,1]), label)
                si9++
            }
            // Data polygon filled
            var dataPts = []
            var si10 = 0
            while (si10 < sides) {
                var ang = si10/sides*PI2 - PI/2
                var rv = radarData[si10]*r4
                push(dataPts, cx4+cos(ang)*rv); push(dataPts, cy4+sin(ang)*rv)
                si10++
            }
            var fillCol = packColor(mix(accent[0], black, 0.5))
            var fillCol2 = packColor([accent[0][0],accent[0][1],accent[0][2],0.15])
            dl.addConvexPolyFilled(dataPts, fillCol2)
            dl.addPolyline(dataPts, fillCol, true, 2.0, UI.DRAW_NONE)
            // Dots at vertices
            si10 = 0
            while (si10 < sides) {
                var ang = si10/sides*PI2 - PI/2
                var rv = radarData[si10]*r4
                dl.addCircleFilled(cx4+cos(ang)*rv, cy4+sin(ang)*rv, 4, packColor(accent[0]), 0)
                si10++
            }

            UI.dummy(0, 220)
        })

        UI.dummy(0,4)
        var i11 = 0
        while (i11 < length(radarData)) {
            UI.id("rd-"+str(i11), func() {
                var ref = [radarData[i11]]
                UI.setNextItemWidth(120)
                UI.sliderFloat(radarLabels[i11], ref, 0.0, 1.0)
                radarData[i11] = ref[0]
            })
            if (i11 % 2 == 0 and i11 < length(radarData)-1) { UI.sameLine() }
            i11++
        }

        UI.dummy(0,8)
        secHeader("Sparkline with fill", "path API filled area")
        UI.child("spark-area", { w:0, h:100, border:true }, func() {
            var dl  = UI.drawList()
            var p   = UI.getCursorPos()
            var cw4 = UI.getWindowWidth()-20; var ch4 = 75.0
            var n   = length(sparkData)
            var mn  = sparkData[0]; var mx = sparkData[0]
            var si12 = 0
            while (si12 < n) {
                if (sparkData[si12] < mn) { mn = sparkData[si12] }
                if (sparkData[si12] > mx) { mx = sparkData[si12] }
                si12++
            }

            // Build fill path (bottom L → data points → bottom R)
            dl.pathLineTo(p.x, p.y+ch4)
            si12 = 0
            while (si12 < n) {
                var x4 = p.x + (si12/(n-1))*cw4
                var y4 = p.y + ch4 - ((sparkData[si12]-mn)/(mx-mn))*ch4*0.85 - 4
                dl.pathLineTo(x4, y4)
                si12++
            }
            dl.pathLineTo(p.x+cw4, p.y+ch4)
            dl.pathFillConcave(packColor([accent[0][0],accent[0][1],accent[0][2],0.15]))

            // Stroke line
            dl.pathClear()
            si12 = 0
            while (si12 < n) {
                var x4 = p.x + (si12/(n-1))*cw4
                var y4 = p.y + ch4 - ((sparkData[si12]-mn)/(mx-mn))*ch4*0.85 - 4
                dl.pathLineTo(x4, y4)
                si12++
            }
            dl.pathStroke(packColor(accent[0]), false, 2.0, UI.DRAW_NONE)

            // Last value dot
            var lx = p.x + cw4
            var ly = p.y + ch4 - ((sparkData[n-1]-mn)/(mx-mn))*ch4*0.85 - 4
            dl.addCircleFilled(lx, ly, 4, packColor(accent[0]), 0)

            UI.dummy(0, ch4+8)
        })

        UI.dummy(0,8)
        secHeader("Bezier curve editor", "drag control points")
        UI.child("bez-area", { w:0, h:0, border:true }, func() {
            var dl  = UI.drawList()
            var p   = UI.getCursorPos()
            var cw5 = UI.getWindowWidth()-20; var ch5 = UI.getWindowHeight()-20

            // Draw curve
            dl.addBezierCubic(
                p.x+bezCtrlPts[0][0], p.y+bezCtrlPts[0][1],
                p.x+bezCtrlPts[1][0], p.y+bezCtrlPts[1][1],
                p.x+bezCtrlPts[2][0], p.y+bezCtrlPts[2][1],
                p.x+bezCtrlPts[3][0], p.y+bezCtrlPts[3][1],
                packColor(accent[0]), 2.5
            )
            // Control lines
            dl.addLine(p.x+bezCtrlPts[0][0], p.y+bezCtrlPts[0][1],
                       p.x+bezCtrlPts[1][0], p.y+bezCtrlPts[1][1],
                       packColor([1,1,1,0.18]), 1.0)
            dl.addLine(p.x+bezCtrlPts[2][0], p.y+bezCtrlPts[2][1],
                       p.x+bezCtrlPts[3][0], p.y+bezCtrlPts[3][1],
                       packColor([1,1,1,0.18]), 1.0)
            // Control point dots
            var bci = 0
            while (bci < 4) {
                var bx = p.x+bezCtrlPts[bci][0]; var by = p.y+bezCtrlPts[bci][1]
                var isEnd = bci==0 or bci==3
                var col2  = isEnd ? packColor(accent[0]) : packColor([0.98,0.72,0.38,1])
                dl.addCircleFilled(bx, by, 7, col2, 0)
                dl.addCircle(bx, by, 7, packColor([1,1,1,0.3]), 0, 1.0)

                UI.setCursorPos(bx-8-p.x, by-8-p.y)
                UI.invisibleButton("bcp-"+str(bci), 16, 16)
                if (UI.isItemActive()) {
                    var delta = UI.getMouseDragDelta(0)
                    bezCtrlPts[bci][0] = bezCtrlPts[bci][0] + delta.x
                    bezCtrlPts[bci][1] = bezCtrlPts[bci][1] + delta.y
                    if (bezCtrlPts[bci][0] < 0)    { bezCtrlPts[bci][0] = 0 }
                    if (bezCtrlPts[bci][0] > cw5)  { bezCtrlPts[bci][0] = cw5 }
                    if (bezCtrlPts[bci][1] < 0)    { bezCtrlPts[bci][1] = 0 }
                    if (bezCtrlPts[bci][1] > ch5)  { bezCtrlPts[bci][1] = ch5 }
                    UI.resetMouseDragDelta(0)
                }
                if (UI.isItemHovered()) { UI.tooltip(isEnd ? "Endpoint" : "Control point") }
                bci++
            }
            UI.setCursorPos(p.x, p.y+ch5+4)
            UI.dummy(0, 0)
        })
    })
}

