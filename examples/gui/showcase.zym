// ZYM UI showcase — a real mini-app built on the Slice 1 primitives.
//
// This is not a binding tour. It's a small, functional task tracker
// that uses the ImGui-via-ZYM surface to do something real:
//
//   * add tasks via a modal popup (button family, input text, modal,
//     scoped containers, ref convention via Buffer + single-elem list)
//   * list / filter / complete tasks (table, combo, checkbox, selectable,
//     popup context menu, disabled subtree)
//   * track completion stats over time (plot lines / histogram fed from
//     actual app state, progress bar)
//   * draw a custom "card" panel via drawList primitives (real layout,
//     not a demo grid)
//   * theme the canvas via a colorPicker that drives draw colors
//   * full menu bar with file / edit / view actions wired to app state
//   * status bar with framerate + counters
//   * keyboard-style confirmation modal on "clear completed"
//
// Every widget here serves the app — nothing is in this file purely
// to "demonstrate the binding exists." For a tour of every binding
// see `examples/gui/widgets.zym`.
//
// Manual run only — needs a display, so not wired into runAll.sh.
//
// Usage:
//   zym run examples/gui/showcase.zym

var win = SDL.createWindow("zym tasks", 960, 640, { resizable: true })
if (win == null) { print("createWindow failed: %v", SDL.lastError()); return }

// ============================================================== state ==

// Tasks are stored as a parallel-list "table": one row per task,
// each row is [title, priority, category, completed].
//
//   priority : 0=low 1=med 2=high
//   category : index into categories
//   completed: bool

var categories = ["work", "personal", "shopping", "learning"]
var prio_names = ["low", "med", "high"]

var task_titles    = []
var task_prios     = []
var task_cats      = []
var task_done      = []

// Seed a few tasks so the app has content on first launch.
func seedTask(title, prio, cat, done) {
    push(task_titles, title)
    push(task_prios,  prio)
    push(task_cats,   cat)
    push(task_done,   done)
}
seedTask("write release notes",      2, 0, false)
seedTask("review PR #214",           1, 0, true)
seedTask("buy coffee beans",         0, 2, false)
seedTask("study imgui drawlist API", 1, 3, true)
seedTask("fix segfault in batch 7",  2, 0, false)
seedTask("call mom",                 1, 1, false)

// ---- ui state refs ---------------------------------------------------

var new_title_buf = Buffer.new(128)
var new_prio      = [1]
var new_cat       = [0]

var filter_cat    = [0]      // 0 = "all", 1..N = categories[N-1]
var filter_items  = ["all", "work", "personal", "shopping", "learning"]
var filter_prio   = [0]      // 0 = any, 1=low, 2=med, 3=high
var filter_prio_items = ["any priority", "low", "med", "high"]
var hide_done     = [false]

var theme_accent  = [0.30, 0.65, 0.95, 1.0]
var theme_bg      = [0.12, 0.14, 0.18, 1.0]
var theme_warn    = [0.95, 0.60, 0.20, 1.0]

// Completion history: ratio of done/total recorded once per second.
// Drives the plotLines + plotHistogram + progressBar widgets.
var history_done  = []
var history_total = []
var history_last_t = 0.0

// ---- modal/popup triggers --------------------------------------------

var want_add_modal     = false
var want_clear_confirm = false
var pending_delete_idx = -1
var done_flag          = false

// ============================================================ helpers ==

func taskCount() {
    return length(task_titles)
}

func doneCount() {
    var n = 0
    var i = 0
    while (i < length(task_done)) {
        if (task_done[i]) { n = n + 1 }
        i = i + 1
    }
    return n
}

func pendingCount() {
    return taskCount() - doneCount()
}

// Filter predicate: returns true if task `i` should be visible
// given the current filter/hide_done settings.
func taskVisible(i) {
    if (hide_done[0] and task_done[i]) { return false }
    if (filter_cat[0] != 0) {
        var want_cat = filter_cat[0] - 1
        if (task_cats[i] != want_cat) { return false }
    }
    if (filter_prio[0] != 0) {
        var want_prio = filter_prio[0] - 1
        if (task_prios[i] != want_prio) { return false }
    }
    return true
}

// "Delete" by rebuilding the parallel lists without the matched index.
// Zym doesn't ship list.removeAt, so this is the idiomatic approach
// for the showcase — and it doubles as a "scripts can compose freely"
// demo since the filter row uses the same shape.
func removeTask(idx) {
    var new_t = []
    var new_p = []
    var new_c = []
    var new_d = []
    var i = 0
    while (i < length(task_titles)) {
        if (i != idx) {
            push(new_t, task_titles[i])
            push(new_p, task_prios[i])
            push(new_c, task_cats[i])
            push(new_d, task_done[i])
        }
        i = i + 1
    }
    task_titles = new_t
    task_prios  = new_p
    task_cats   = new_c
    task_done   = new_d
}

func clearCompleted() {
    var new_t = []
    var new_p = []
    var new_c = []
    var new_d = []
    var i = 0
    while (i < length(task_titles)) {
        if (!task_done[i]) {
            push(new_t, task_titles[i])
            push(new_p, task_prios[i])
            push(new_c, task_cats[i])
            push(new_d, task_done[i])
        }
        i = i + 1
    }
    task_titles = new_t
    task_prios  = new_p
    task_cats   = new_c
    task_done   = new_d
}

func addTaskFromBuffer() {
    // Buffer.toUtf8() returns the buffer's bytes as a string, stripping
    // trailing NULs added by InputText.
    var title = new_title_buf.toUtf8()
    if (length(title) == 0) { return false }
    push(task_titles, title)
    push(task_prios,  new_prio[0])
    push(task_cats,   new_cat[0])
    push(task_done,   false)
    // Zero the bytes in place instead of `.clear()`, which would shrink
    // the underlying buffer to size 0 and leave ImGui's inputText with
    // no room to grow on the next edit. fill(0) keeps the capacity.
    new_title_buf.fill(0)
    return true
}

// Pack a [r,g,b,a] float ref into a 32-bit RGBA via UI.color.
func packColor(c) {
    return UI.color(c[0] * 255.0, c[1] * 255.0, c[2] * 255.0, c[3] * 255.0)
}

// ---- toolbar (reusable layout fragment) -------------------------------

func renderToolbar() {
    if (UI.button("+ add task")) { want_add_modal = true }
    UI.sameLine()
    if (UI.button("clear completed")) { want_clear_confirm = true }
    UI.sameLine()
    UI.checkbox("hide completed", hide_done)
    UI.sameLine()
    UI.text("|")
    UI.sameLine()
    UI.combo("category", filter_cat, filter_items)
    UI.sameLine()
    UI.combo("##prio", filter_prio, filter_prio_items)
}

// =========================================================== main loop =

while (!win.shouldClose() and !done_flag) {
    var e = SDL.pollEvent()
    while (e != null) {
        e = SDL.pollEvent()
    }

    UI.frame(win, func() {

        // ---- main menu bar --------------------------------------------
        UI.mainMenuBar(func() {
            UI.menu("file", func() {
                if (UI.menuItem("new task...", "ctrl+n")) {
                    want_add_modal = true
                }
                UI.separator()
                if (UI.menuItem("quit", "ctrl+q")) {
                    // Set a script-side flag and let the outer loop
                    // exit cleanly at the top of the next iteration.
                    done_flag = true
                }
            })
            UI.menu("edit", func() {
                if (UI.menuItem("clear completed")) {
                    want_clear_confirm = true
                }
                if (UI.menuItem("mark all done")) {
                    var i = 0
                    while (i < length(task_done)) {
                        task_done[i] = true
                        i = i + 1
                    }
                }
                if (UI.menuItem("mark all pending")) {
                    var i = 0
                    while (i < length(task_done)) {
                        task_done[i] = false
                        i = i + 1
                    }
                }
            })
            UI.menu("view", func() {
                UI.menuItem("hide completed", null, hide_done)
            })
        })

        // ---- record completion history once per second ---------------
        var now = UI.framerate()  // we don't have a clock binding yet,
                                  // so we tick history every ~60 frames
        if (length(history_done) == 0 or (length(history_done) < 120 and history_last_t > 30.0)) {
            push(history_done,  doneCount())
            push(history_total, taskCount())
            history_last_t = 0.0
        } else {
            history_last_t = history_last_t + 1.0
        }

        // ---- root pane: fill the entire SDL window (minus menu bar) -
        // Pin the ImGui window to (0, menu_h) and size it to the SDL
        // window, with all chrome turned off so it acts as the app
        // itself rather than a floating sub-window inside the app.
        var ws = win.getSize()
        var menu_h = 22.0
        UI.setNextWindowPos(0, menu_h)
        UI.setNextWindowSize(ws.w + 0.0, ws.h - menu_h)
        var root_flags = UI.WINDOW_NO_TITLE_BAR
        root_flags = root_flags + UI.WINDOW_NO_RESIZE
        root_flags = root_flags + UI.WINDOW_NO_MOVE
        root_flags = root_flags + UI.WINDOW_NO_COLLAPSE
        root_flags = root_flags + UI.WINDOW_NO_BRING_TO_FRONT_ON_FOCUS
        root_flags = root_flags + UI.WINDOW_NO_SAVED_SETTINGS
        UI.window("zym tasks", root_flags, func() {

            renderToolbar()
            UI.separator()

            // ----- left side: task table inside a scrollable child ----
            UI.text("tasks (" + str(pendingCount()) + " pending / " + str(taskCount()) + " total):")

            UI.child("task_panel", 0, 280, true, func() {
                UI.table("tasks_table", 5, func() {
                    UI.tableSetupColumn("done")
                    UI.tableSetupColumn("title")
                    UI.tableSetupColumn("prio")
                    UI.tableSetupColumn("category")
                    UI.tableSetupColumn("")
                    UI.tableHeadersRow()

                    var i = 0
                    while (i < length(task_titles)) {
                        if (taskVisible(i)) {
                            UI.id(i, func() {
                                UI.tableNextRow()

                                // column 0 — completion checkbox
                                UI.tableNextColumn()
                                var done_ref = [task_done[i]]
                                UI.checkbox("##d", done_ref)
                                task_done[i] = done_ref[0]

                                // column 1 — title, struck through visually
                                // if completed (via textDisabled).
                                UI.tableNextColumn()
                                if (task_done[i]) {
                                    UI.textDisabled(task_titles[i])
                                } else {
                                    UI.text(task_titles[i])
                                }

                                // column 2 — priority label, colored
                                UI.tableNextColumn()
                                var prio = task_prios[i]
                                if (prio == 2) {
                                    UI.textColored(theme_warn, prio_names[prio])
                                } else if (prio == 1) {
                                    UI.text(prio_names[prio])
                                } else {
                                    UI.textDisabled(prio_names[prio])
                                }

                                // column 3 — category label
                                UI.tableNextColumn()
                                UI.text(categories[task_cats[i]])

                                // column 4 — delete button
                                UI.tableNextColumn()
                                if (UI.smallButton("x")) {
                                    pending_delete_idx = i
                                }
                            })
                        }
                        i = i + 1
                    }
                })
            })

            UI.separator()

            // ----- bottom split: stats panel + custom card ------------
            UI.child("bottom_left", 460, 200, true, func() {
                UI.text("completion stats")
                UI.separator()

                var done_n = doneCount()
                var total_n = taskCount()
                var ratio = 0.0
                if (total_n > 0) { ratio = (done_n + 0.0) / total_n }

                UI.text("done: " + str(done_n) + " / " + str(total_n))
                UI.progressBar(ratio, 0, 0, str(done_n) + "/" + str(total_n))

                UI.dummy(0, 4)
                UI.text("completion history (last " + str(length(history_done)) + " ticks):")
                if (length(history_done) > 1) {
                    UI.plotLines("##done_hist", history_done, "done",
                                 0.0, 1.0)
                    UI.plotHistogram("##total_hist", history_total, "total",
                                     0.0, 1.0)
                } else {
                    UI.textDisabled("(building history... let the app run a moment)")
                }
            })

            UI.sameLine()

            UI.child("bottom_right", 0, 200, true, func() {
                UI.text("custom drawList card")
                UI.separator()

                var cp = UI.getCursorPos()
                var x = cp.x
                var y = cp.y
                var w = 380.0
                var h = 130.0

                // background panel using the theme bg color
                UI.drawRectFilled(x, y, w, h, packColor(theme_bg))
                UI.drawRect(x, y, w, h, packColor(theme_accent))

                // bars representing per-category counts
                var counts = [0, 0, 0, 0]
                var ci = 0
                while (ci < length(task_cats)) {
                    var c = task_cats[ci]
                    counts[c] = counts[c] + 1
                    ci = ci + 1
                }
                var max_count = 1
                var k = 0
                while (k < 4) {
                    if (counts[k] > max_count) { max_count = counts[k] }
                    k = k + 1
                }

                var bar_y = y + 24
                var bar_x = x + 110
                var bar_w_max = 240
                var bar_h = 14
                var bar_gap = 8
                var bi = 0
                while (bi < 4) {
                    var label_y = bar_y + (bar_h + bar_gap) * bi
                    UI.drawText(x + 12, label_y, packColor(theme_accent),
                                categories[bi])
                    var bw = (bar_w_max + 0.0) * counts[bi] / max_count
                    UI.drawRectFilled(bar_x, label_y, bw, bar_h,
                                      packColor(theme_accent))
                    UI.drawRect(bar_x, label_y, bar_w_max, bar_h,
                                packColor(theme_accent))
                    UI.drawText(bar_x + bar_w_max + 6, label_y,
                                packColor(theme_accent), str(counts[bi]))
                    bi = bi + 1
                }

                // reserve the canvas footprint
                UI.dummy(w, h)
            })

            UI.separator()

            // ----- theme controls (drive drawList colors) -------------
            UI.treeNode("theme", func() {
                UI.text("these colors drive the custom-drawn card above")
                UI.colorEdit("accent", theme_accent)
                UI.colorEdit("background", theme_bg)
                UI.colorEdit("warn", theme_warn)
                UI.separator()
                UI.textDisabled("tip: try changing accent to see all card text/bars retint live")
            })

            UI.separator()

            // ----- status bar ----------------------------------------
            UI.text("fps: " + str(UI.framerate()))
            UI.sameLine(200)
            UI.text(str(pendingCount()) + " pending")
            UI.sameLine(320)
            UI.text(str(doneCount()) + " done")
            UI.sameLine(420)
            UI.textDisabled("zym ui showcase — built on UI/SDL primitives")
        })

        // ---- modal: add task ----------------------------------------
        if (want_add_modal) {
            UI.openPopup("add_task_modal")
            want_add_modal = false
        }
        UI.popupModal("add_task_modal", func() {
            UI.text("add a new task")
            UI.separator()

            UI.inputText("title", new_title_buf)
            UI.combo("priority", new_prio, prio_names)
            UI.combo("category", new_cat, categories)

            UI.separator()

            var title_now = new_title_buf.toUtf8()
            UI.disabled(length(title_now) == 0, func() {
                if (UI.button("add", 100, 0)) {
                    addTaskFromBuffer()
                    UI.closeCurrentPopup()
                }
            })
            UI.sameLine()
            if (UI.button("cancel", 100, 0)) {
                new_title_buf.fill(0)
                UI.closeCurrentPopup()
            }
        })

        // ---- modal: confirm clear completed -------------------------
        if (want_clear_confirm) {
            UI.openPopup("confirm_clear")
            want_clear_confirm = false
        }
        UI.popupModal("confirm_clear", func() {
            UI.text("clear all completed tasks?")
            UI.text("(" + str(doneCount()) + " tasks will be removed)")
            UI.separator()
            if (UI.button("yes, clear", 120, 0)) {
                clearCompleted()
                UI.closeCurrentPopup()
            }
            UI.sameLine()
            if (UI.button("cancel", 120, 0)) {
                UI.closeCurrentPopup()
            }
        })

        // ---- deferred delete (table iteration is over by now) -------
        if (pending_delete_idx >= 0) {
            removeTask(pending_delete_idx)
            pending_delete_idx = -1
        }
    })
}

win.free()
print("showcase exit — final %v tasks (%v done)", taskCount(), doneCount())
