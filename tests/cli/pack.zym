// ============================================================================
// COMPREHENSIVE Pack NATIVE TEST SUITE
// Exercises the `Pack` global: from-scratch `Pack.build`, the read-only
// bundle handle (`Pack.openFile` / `Pack.openBuffer`), and — the focus of
// this suite — the edit-transaction API: `Pack.editFile` / `Pack.editBuffer`
// plus every staged op (`add` / `remove` / `replace` / `rename` / `move` /
// `setEntryIndex` / `setFlags` / `setCustom` / `setStub`) and `commit`.
//
// Filesystem paths used by the suite all live next to this test file in the
// current working directory; the suite cleans them up at start and end.
// ============================================================================

var testsPassed = 0
var testsFailed = 0

func assert_wrap(condition, message) {
    if (condition) {
        testsPassed = testsPassed + 1
    } else {
        testsFailed = testsFailed + 1
        print("FAILED: " + message)
    }
}

print("==========================================================")
print("Pack NATIVE TEST SUITE")
print("==========================================================")

// Quiet the speculative reader probes that `Pack.build` runs against a
// fresh native binary stub when packing a stub-wrapped bundle. We don't
// pack stubs here, but flip it off explicitly so the suite output is
// stable regardless of the previous Pack.verbose state.
Pack.setVerboseOutput(false)

// ----------------------------------------------------------------------------
// Common paths and cleanup
// ----------------------------------------------------------------------------
var P_BASE   = "_pack_test_base.zpk"
var P_EDIT   = "_pack_test_edit.zpk"
var P_DET_A  = "_pack_test_det_a.zpk"
var P_DET_B  = "_pack_test_det_b.zpk"

File.remove(P_BASE)
File.remove(P_EDIT)
File.remove(P_DET_A)
File.remove(P_DET_B)


// ============================================================================
// SECTION 1: Pack.build prerequisite (we need a bundle to edit)
// ============================================================================
print("--- [1] Pack.build prerequisite ---")

// A tiny bytecode-shaped blob; ZPK doesn't validate the contents of an
// entry_bytecode against any real bytecode format, only its kind byte and
// CRC, so any non-empty payload works as an entry-point stand-in here.
var mainBc = Buffer.fromString("(fake entry bytecode payload)")
var cfg    = Buffer.fromString("greeting=hello\nname=world\n")
var blobA  = Buffer.fromList([0xDE, 0xAD, 0xBE, 0xEF])

var built = Pack.build({
    output: P_BASE,
    entryIndex: 0,
    entries: [
        { name: "main.zbc",     kind: "entry_bytecode", data: mainBc },
        { name: "config.ini",   kind: "file",           data: cfg },
        { name: "blob_a",       kind: "blob",           data: blobA }
    ]
})
assert_wrap(built == true,                          "1.1: Pack.build returns true")
assert_wrap(File.exists(P_BASE) == true,            "1.2: base bundle exists on disk")


// ============================================================================
// SECTION 2: Pack.editFile open + read-side methods (zero staged ops)
// ============================================================================
print("--- [2] editFile open + read-side ---")

var e = Pack.editFile(P_BASE)
assert_wrap(e != null,                              "2.1: editFile returns non-null on valid bundle")

var list0 = e.list()
assert_wrap(length(list0) == 3,                     "2.2: list() returns 3 entries (matches source)")
assert_wrap(list0[0].name == "main.zbc",            "2.3: list()[0].name")
assert_wrap(list0[1].name == "config.ini",          "2.4: list()[1].name")
assert_wrap(list0[2].name == "blob_a",              "2.5: list()[2].name")

// All entries are unchanged-from-source.
assert_wrap(list0[0].fromSource == true,            "2.6: list()[0].fromSource true (unchanged)")
assert_wrap(list0[1].fromSource == true,            "2.7: list()[1].fromSource true")
assert_wrap(list0[2].fromSource == true,            "2.8: list()[2].fromSource true")

assert_wrap(e.entryIndex() == 0,                    "2.9: entryIndex() == 0 (matches Pack.build)")

var infoByName = e.info("config.ini")
assert_wrap(infoByName != null,                     "2.10: info(string) finds entry by name")
assert_wrap(infoByName.kind == "file",              "2.11: info(string).kind")

var infoByIdx = e.info(2)
assert_wrap(infoByIdx != null,                      "2.12: info(number) finds entry by index")
assert_wrap(infoByIdx.name == "blob_a",             "2.13: info(number).name")

var infoMiss = e.info("nope")
assert_wrap(infoMiss == null,                       "2.14: info(missing) returns null")

assert_wrap(e.close() == true,                      "2.15: close() returns true on first call")


// ============================================================================
// SECTION 3: Determinism — zero-op commit produces byte-identical file
// ============================================================================
print("--- [3] Determinism (zero-op commit) ---")

// Copy P_BASE to two fresh paths and commit one with zero ops; both files
// should be byte-identical afterwards.
var baseBytes = File.readBytes(P_BASE)
File.writeBytes(P_DET_A, baseBytes)
File.writeBytes(P_DET_B, baseBytes)

var eDet = Pack.editFile(P_DET_A)
assert_wrap(eDet != null,                           "3.1: editFile on copy opens")
assert_wrap(eDet.commit() == true,                  "3.2: zero-op commit returns true")
eDet.close()

var detA = File.readBytes(P_DET_A)
var detB = File.readBytes(P_DET_B)
assert_wrap(detA.size() == detB.size(),             "3.3: zero-op commit preserves size")
assert_wrap(detA.equals(detB),                      "3.4: zero-op commit produces byte-identical file")


// ============================================================================
// SECTION 4: add + commit (file path)
// ============================================================================
print("--- [4] add + commit (editFile) ---")

// Work on a fresh copy so each section starts from the same base.
File.writeBytes(P_EDIT, File.readBytes(P_BASE))

var e4 = Pack.editFile(P_EDIT)
assert_wrap(e4 != null,                             "4.1: editFile opens P_EDIT")

var newBlob = Buffer.fromList([0x01, 0x02, 0x03])
var addOk = e4.add({ name: "added", kind: "blob", data: newBlob })
assert_wrap(addOk == true,                          "4.2: add() returns true")

// Staged view reflects the add immediately.
var list4 = e4.list()
assert_wrap(length(list4) == 4,                     "4.3: staged list() size is 4 after add")
assert_wrap(list4[3].name == "added",               "4.4: staged add appended at end")
assert_wrap(list4[3].fromSource == false,           "4.5: staged add row fromSource = false")
assert_wrap(list4[0].fromSource == true,            "4.6: untouched source rows still fromSource = true")

assert_wrap(e4.commit() == true,                    "4.7: commit() returns true")
e4.close()

// Re-open and verify the new entry is persisted.
var v4 = Pack.openFile(P_EDIT)
assert_wrap(v4 != null,                             "4.8: re-open after add commit")
assert_wrap(length(v4.list()) == 4,                 "4.9: on-disk has 4 entries")
v4.close()


// ============================================================================
// SECTION 5: remove + commit
// ============================================================================
print("--- [5] remove + commit ---")

File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e5 = Pack.editFile(P_EDIT)
assert_wrap(e5.remove("blob_a") == true,            "5.1: remove by name")
assert_wrap(length(e5.list()) == 2,                 "5.2: staged view shrinks after remove")

// Also test remove by index — pop the original first non-entry slot
// ("config.ini" is now at index 1 in the *staged* view).
assert_wrap(e5.remove(1) == true,                   "5.3: remove by index")
assert_wrap(length(e5.list()) == 1,                 "5.4: staged view shrinks to 1")
assert_wrap(e5.list()[0].name == "main.zbc",        "5.5: remaining entry is the entry-point")
assert_wrap(e5.entryIndex() == 0,                   "5.6: entryIndex still 0 after removes")

assert_wrap(e5.commit() == true,                    "5.7: commit removes")
e5.close()

var v5 = Pack.openFile(P_EDIT)
assert_wrap(length(v5.list()) == 1,                 "5.8: persisted bundle has 1 entry")
assert_wrap(v5.list()[0].name == "main.zbc",        "5.9: remaining entry persisted")
v5.close()


// ============================================================================
// SECTION 6: replace (identity-preserving) + commit
// ============================================================================
print("--- [6] replace + commit ---")

File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e6 = Pack.editFile(P_EDIT)

var newCfg = Buffer.fromString("greeting=hi\nname=zym\n")
assert_wrap(e6.replace("config.ini", { data: newCfg }) == true,
                                                    "6.1: replace by name returns true")

// Staged view still has the same shape; just one row's fromSource flipped.
var list6 = e6.list()
assert_wrap(length(list6) == 3,                     "6.2: replace preserves size")
assert_wrap(list6[1].name == "config.ini",          "6.3: replace preserves slot name when unchanged")
assert_wrap(list6[1].fromSource == false,           "6.4: replaced row fromSource = false")
// `entryIndex` (slot 0) untouched.
assert_wrap(e6.entryIndex() == 0,                   "6.5: replace doesn't move entryIndex")

assert_wrap(e6.commit() == true,                    "6.6: commit replace")
e6.close()

// Verify the actual bytes round-trip through openFile.open()
var v6 = Pack.openFile(P_EDIT)
var cfgRead = v6.open("config.ini")
assert_wrap(cfgRead != null,                        "6.7: bundle.open() finds replaced entry")
assert_wrap(cfgRead.toUtf8() == "greeting=hi\nname=zym\n",
                                                    "6.8: replaced bytes round-trip")
v6.close()


// ============================================================================
// SECTION 7: rename + commit
// ============================================================================
print("--- [7] rename + commit ---")

File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e7 = Pack.editFile(P_EDIT)
assert_wrap(e7.rename("config.ini", "config.txt") == true,
                                                    "7.1: rename returns true")
assert_wrap(e7.list()[1].name == "config.txt",      "7.2: staged view sees rename")
assert_wrap(e7.info("config.ini") == null,          "7.3: old name no longer resolves in staged view")
assert_wrap(e7.info("config.txt") != null,          "7.4: new name resolves in staged view")
assert_wrap(e7.commit() == true,                    "7.5: rename commit")
e7.close()

var v7 = Pack.openFile(P_EDIT)
assert_wrap(v7.info("config.txt") != null,          "7.6: rename persisted")
assert_wrap(v7.info("config.ini") == null,          "7.7: old name gone after rename")
v7.close()


// ============================================================================
// SECTION 8: move (reorder) + commit
// ============================================================================
print("--- [8] move + commit ---")

File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e8 = Pack.editFile(P_EDIT)

// Move "main.zbc" (idx 0, entry-point) to the end. entryIndex must follow.
assert_wrap(e8.move("main.zbc", 2) == true,         "8.1: move returns true")
var list8 = e8.list()
assert_wrap(list8[0].name == "config.ini",          "8.2: post-move [0]")
assert_wrap(list8[1].name == "blob_a",              "8.3: post-move [1]")
assert_wrap(list8[2].name == "main.zbc",            "8.4: post-move [2]")
assert_wrap(e8.entryIndex() == 2,                   "8.5: entryIndex follows the moved entry")
assert_wrap(e8.commit() == true,                    "8.6: move commit")
e8.close()

var v8 = Pack.openFile(P_EDIT)
assert_wrap(v8.list()[2].name == "main.zbc",        "8.7: move persisted")
assert_wrap(v8.list()[2].isEntry == true,           "8.8: entry-point persisted at new index")
v8.close()


// ============================================================================
// SECTION 9: setFlags + setCustom + commit
// ============================================================================
print("--- [9] setFlags + setCustom + commit ---")

File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e9 = Pack.editFile(P_EDIT)

// setFlags via {required, lazy} map.
assert_wrap(e9.setFlags("config.ini", { required: true, lazy: false }) == true,
                                                    "9.1: setFlags(map) returns true")
// setCustom u32.
assert_wrap(e9.setCustom("blob_a", 0xCAFEBABE) == true,
                                                    "9.2: setCustom(u32) returns true")
// setFlags via raw numeric mask.
assert_wrap(e9.setFlags(2, 0x02) == true,           "9.3: setFlags(number) by-index returns true")

assert_wrap(e9.commit() == true,                    "9.4: commit flag/custom edits")
e9.close()

var v9 = Pack.openFile(P_EDIT)
var i9cfg = v9.info("config.ini")
assert_wrap(i9cfg.required == true,                 "9.5: required flag persisted")
assert_wrap(i9cfg.lazy == false,                    "9.6: lazy flag cleared")
var i9blob = v9.info("blob_a")
assert_wrap(i9blob.custom == 0xCAFEBABE,            "9.7: custom u32 persisted")
v9.close()


// ============================================================================
// SECTION 10: setEntryIndex + commit
// ============================================================================
print("--- [10] setEntryIndex + commit ---")

// Add a second entry-kind entry, then point entryIndex at it. Wait — the
// format rejects two entry-kind entries in the same bundle, so we instead
// just exercise setEntryIndex by re-targeting at the same slot via name.
// That still verifies the op runs and the commit-time kind check passes.
File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e10 = Pack.editFile(P_EDIT)
assert_wrap(e10.setEntryIndex("main.zbc") == true,  "10.1: setEntryIndex by-name on valid kind")
assert_wrap(e10.commit() == true,                   "10.2: commit setEntryIndex")
e10.close()

var v10 = Pack.openFile(P_EDIT)
assert_wrap(v10.entryName() == "main.zbc",          "10.3: entryName persisted (entryIndex points at main.zbc)")
v10.close()

// Negative case: pointing at a non-entry-kind row should fail at commit.
File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e10b = Pack.editFile(P_EDIT)
assert_wrap(e10b.setEntryIndex("config.ini") == true,
                                                    "10.4: setEntryIndex on bad kind stages OK (validation is at commit)")
// Commit must fail because config.ini is kind=file, not an entry kind.
// We can't catch the runtime error from script land, but we expect the
// pre-commit ops to still be there if the script could observe.
// Just call commit and verify the source file was *not* mutated.
var preCommitBytes = File.readBytes(P_EDIT)
// commit will raise on invalid entryIndex — but raising from a script
// callee aborts the test, so we instead verify staging worked and skip
// the call. (The commit-time check is exercised by other paths.)
e10b.close()
var postCloseBytes = File.readBytes(P_EDIT)
assert_wrap(preCommitBytes.equals(postCloseBytes),  "10.5: failed-stage close() leaves source file untouched")


// ============================================================================
// SECTION 11: setStub null (strip stub) — applied to a headless bundle
// ============================================================================
print("--- [11] setStub(null) on headless bundle ---")

// P_BASE is already headless (no stub passed to Pack.build), so stripping
// the stub is a no-op semantically — but the op must still commit cleanly.
File.writeBytes(P_EDIT, File.readBytes(P_BASE))
var e11 = Pack.editFile(P_EDIT)
assert_wrap(e11.setStub(null) == true,              "11.1: setStub(null) stages")
assert_wrap(e11.commit() == true,                   "11.2: setStub(null) commits on already-headless bundle")
e11.close()

var afterStrip = File.readBytes(P_EDIT)
var baseRef    = File.readBytes(P_BASE)
assert_wrap(afterStrip.size() == baseRef.size(),    "11.3: stripped-headless size matches source")
// Stronger: the bundle is still openable.
var v11 = Pack.openFile(P_EDIT)
assert_wrap(v11 != null,                            "11.4: post-strip bundle still opens")
v11.close()


// ============================================================================
// SECTION 12: Pack.editBuffer — open + read-side
// ============================================================================
print("--- [12] editBuffer open + read-side ---")

var bufBytes = File.readBytes(P_BASE)
var origSize = bufBytes.size()
var eb = Pack.editBuffer(bufBytes)
assert_wrap(eb != null,                             "12.1: editBuffer returns non-null")
assert_wrap(length(eb.list()) == 3,                 "12.2: editBuffer list() size")
assert_wrap(eb.info("config.ini") != null,          "12.3: editBuffer info() by name")
assert_wrap(eb.entryIndex() == 0,                   "12.4: editBuffer entryIndex()")
assert_wrap(eb.close() == true,                     "12.5: editBuffer close()")
// No commit was called, so the buffer must be untouched.
assert_wrap(bufBytes.size() == origSize,            "12.6: close() without commit leaves buffer untouched")


// ============================================================================
// SECTION 13: editBuffer commit + caller-observable mutation through a function
// ============================================================================
print("--- [13] editBuffer commit mutates the borrowed buffer ---")

// Define a function that takes a Buffer and mutates the bundle in place.
// After return, the caller's local Buffer should observe the new contents.
func patchConfig(bundleBuf, newCfgBytes) {
    var ed = Pack.editBuffer(bundleBuf)
    ed.replace("config.ini", { data: newCfgBytes })
    ed.commit()
    ed.close()
}

var workBuf = File.readBytes(P_BASE)
var beforeSize = workBuf.size()
var newConfig  = Buffer.fromString("greeting=howdy\nname=editbuffer\n")
patchConfig(workBuf, newConfig)
// The caller's local `workBuf` now reflects the mutation.
assert_wrap(workBuf.size() != 0,                    "13.1: post-mutation buffer is non-empty")
// We can re-open it and read the patched config back.
var vbuf = Pack.openBuffer(workBuf)
assert_wrap(vbuf != null,                           "13.2: mutated buffer opens as a valid bundle")
var cfgFromBuf = vbuf.open("config.ini")
assert_wrap(cfgFromBuf != null,                     "13.3: mutated buffer has config.ini")
assert_wrap(cfgFromBuf.toUtf8() == "greeting=howdy\nname=editbuffer\n",
                                                    "13.4: patched config bytes observable from caller")
vbuf.close()


// ============================================================================
// SECTION 14: Error / null paths
// ============================================================================
print("--- [14] Error / null paths ---")

// editFile on missing path returns null, doesn't raise.
File.remove("_pack_test_nope.zpk")
var eMiss = Pack.editFile("_pack_test_nope.zpk")
assert_wrap(eMiss == null,                          "14.1: editFile on missing path returns null")

// editBuffer on a non-bundle Buffer returns null.
var junk = Buffer.fromString("this is not a .zpk")
var eJunk = Pack.editBuffer(junk)
assert_wrap(eJunk == null,                          "14.2: editBuffer on non-bundle returns null")

// Closing twice is fine (idempotent).
var e14 = Pack.editFile(P_BASE)
e14.close()
assert_wrap(e14.close() == true || e14.close() == false,
                                                    "14.3: double close() doesn't raise")


// ============================================================================
// SECTION 15: Cleanup
// ============================================================================
print("--- [15] Cleanup ---")

File.remove(P_BASE)
File.remove(P_EDIT)
File.remove(P_DET_A)
File.remove(P_DET_B)
assert_wrap(File.exists(P_BASE) == false,           "15.1: base bundle removed")
assert_wrap(File.exists(P_EDIT) == false,           "15.2: edit bundle removed")
assert_wrap(File.exists(P_DET_A) == false,          "15.3: det_a bundle removed")
assert_wrap(File.exists(P_DET_B) == false,          "15.4: det_b bundle removed")


// ============================================================================
// FINAL RESULTS
// ============================================================================
print("")
print("==========================================================")
print("TEST RESULTS")
print("==========================================================")
print("Tests Passed: %v", testsPassed)
print("Tests Failed: %v", testsFailed)
if (testsFailed == 0) {
    print("ALL TESTS PASSED!")
} else {
    print("SOME TESTS FAILED!")
}
print("==========================================================")
