// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Anatole DP
//
// ZYM TUNES -- a modern music player UI showcase.
//
// Demonstrates what a polished, modern application UI looks like built on
// ZYM's UI.* (ImGui) + UI.anim* (ImAnim) surface with full custom drawing.
//
// Everything is mock data -- no audio is played. Cover art is a single
// procedurally-drawn placeholder reused for every track. The point is the
// UI feel: tweened hovers, an animated equalizer, a play/pause morph,
// staggered list reveals, an eased seek bar, and a now-playing panel that
// cross-fades when the track changes.
//
// All UI.anim* calls follow the ui_anim.md signatures:
//   animTweenFloat(id, channelId, target, dur, ease, policy, dt)
//   animTweenColor(id, channelId, target, dur, ease, policy, colorSpace, dt)
//   animShake / animOscillate -- id-addressed, no channelId.
// Drawing uses the UI.drawList() object: addRectFilled(x,y,w,h,col,round,flags).

var win = SDL.createWindow("ZYM Tunes", 1180, 760, { resizable: true })
if (win == null) { print("failed: %v", SDL.lastError()); return }

var PI  = 3.14159265358979
var PI2 = PI * 2.0

// ---------------------------------------------------------------------------
// Theme
// ---------------------------------------------------------------------------

var ACCENT  = [0.40, 0.78, 0.62, 1.0]   // mint green
var ACCENT2 = [0.36, 0.55, 0.95, 1.0]   // blue, for the alt highlight
var BG      = [0.07, 0.075, 0.09, 1.0]
var PANEL   = [0.11, 0.115, 0.135, 1.0]
var PANEL2  = [0.145, 0.15, 0.175, 1.0]
var TEXT    = [0.93, 0.94, 0.96, 1.0]
var TEXTDIM = [0.52, 0.55, 0.60, 1.0]

var packColor = func(c) {
    return UI.color(floor(c[0]*255), floor(c[1]*255), floor(c[2]*255), floor(c[3]*255))
}
var pack01 = func(r, g, b, a) {
    return UI.color(floor(r*255), floor(g*255), floor(b*255), floor(a*255))
}
var ROUND = UI.DRAW_ROUND_CORNERS_ALL

var mix = func(a, b, t) {
    return [a[0]*(1-t)+b[0]*t, a[1]*(1-t)+b[1]*t, a[2]*(1-t)+b[2]*t, a[3]*(1-t)+b[3]*t]
}

var rng = Random.create()

// ---------------------------------------------------------------------------
// Mock library
// ---------------------------------------------------------------------------

// Each track: { title, artist, album, dur (seconds), hue (0..1 for cover tint) }
var library = [
    { title:"Midnight Drive",     artist:"Neon Coast",      album:"Afterglow",        dur:214, hue:0.55 },
    { title:"Paper Planes",       artist:"The Lumen",       album:"Soft Focus",       dur:188, hue:0.10 },
    { title:"Glass Horizon",      artist:"Aria Vale",       album:"Glass Horizon",    dur:241, hue:0.72 },
    { title:"Slow Tide",          artist:"Neon Coast",      album:"Afterglow",        dur:199, hue:0.55 },
    { title:"Velvet Static",      artist:"Mono Bloom",      album:"Roomtone",         dur:227, hue:0.88 },
    { title:"Citrus",             artist:"The Lumen",       album:"Soft Focus",       dur:163, hue:0.10 },
    { title:"Northern Wire",      artist:"Aria Vale",       album:"Glass Horizon",    dur:256, hue:0.72 },
    { title:"Pale Gold",          artist:"Halcyon Park",    album:"Daylight Hours",   dur:201, hue:0.13 },
    { title:"Undertow",           artist:"Mono Bloom",      album:"Roomtone",         dur:233, hue:0.88 },
    { title:"Ferris Wheel",       artist:"Halcyon Park",    album:"Daylight Hours",   dur:178, hue:0.13 },
    { title:"Low Orbit",          artist:"Neon Coast",      album:"Afterglow",        dur:268, hue:0.55 },
    { title:"Saltwater",          artist:"Aria Vale",       album:"Glass Horizon",    dur:222, hue:0.72 },
    { title:"Marigold",           artist:"The Lumen",       album:"Soft Focus",       dur:195, hue:0.10 },
    { title:"Quiet Engine",       artist:"Mono Bloom",      album:"Roomtone",         dur:210, hue:0.88 },
    { title:"Evergreen",          artist:"Halcyon Park",    album:"Daylight Hours",   dur:244, hue:0.13 },
]

// ---------------------------------------------------------------------------
// Player state
// ---------------------------------------------------------------------------

var curTrack    = 0        // index into library
var playing     = false
var playhead    = 0.0      // seconds into the current track
var shuffle     = false
var repeatMode  = 0        // 0 off, 1 all, 2 one
var volume      = [0.72]
var seekHover   = false
var seekGrab    = false
var trackFade   = 1.0      // 1 = fully showing curTrack; dips to 0 on change then back
var libRevealed = false
var hoveredRow  = -1
var clockStart  = Time.clock()
var lastClock   = Time.clock()
var frame       = 0

// equalizer bar levels (mock spectrum) -- smoothed each frame
var eqBars = [0.3,0.5,0.4,0.7,0.55,0.62,0.45,0.5,0.66,0.4,0.58,0.48,
              0.52,0.7,0.44,0.6,0.5,0.55,0.42,0.64]

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

var fmtTime = func(secs) {
    var s = floor(secs)
    var m = floor(s / 60)
    var r = s - m*60
    var rs = str(r)
    if (r < 10) { rs = "0" + rs }
    return str(m) + ":" + rs
}

var hsvToRgb = func(h, s, v) {
    var i = floor(h * 6); var f = h*6-i
    var p = v*(1-s); var q = v*(1-f*s); var t = v*(1-(1-f)*s)
    var m = i % 6
    if (m == 0) { return [v,t,p,1] } if (m == 1) { return [q,v,p,1] }
    if (m == 2) { return [p,v,t,1] } if (m == 3) { return [p,q,v,1] }
    if (m == 4) { return [t,p,v,1] } return [v,p,q,1]
}

// Draw the procedural "cover art": a rounded tile with a soft diagonal
// gradient + a simple geometric mark. `hue` tints it so albums differ.
var drawCover = func(dl, x, y, size, hue, alpha) {
    var top = hsvToRgb(hue, 0.45, 0.85)
    var bot = hsvToRgb((hue + 0.08) % 1.0, 0.65, 0.45)
    // base
    dl.addRectFilled(x, y, size, size,
        pack01(bot[0], bot[1], bot[2], alpha), size*0.12, ROUND)
    // diagonal light band -- a few stacked rects fading down
    var bands = 7
    var bi = 0
    while (bi < bands) {
        var t = bi / (bands * 1.0)
        var c = mix(top, bot, t)
        var bh = size / bands
        dl.addRectFilled(x, y + bi*bh, size, bh + 1,
            pack01(c[0], c[1], c[2], alpha * (1.0 - t*0.45)), 0.0, UI.DRAW_NONE)
        bi++
    }
    // geometric mark -- two overlapping circles, vinyl-ish
    var cx = x + size*0.5; var cy = y + size*0.5
    var mk = hsvToRgb(hue, 0.20, 0.98)
    dl.addCircle(cx, cy, size*0.26, pack01(mk[0],mk[1],mk[2], alpha*0.85), 0, 2.0)
    dl.addCircleFilled(cx, cy, size*0.07, pack01(mk[0],mk[1],mk[2], alpha*0.9), 0)
    // corner rounding overlay handled by base; subtle inner border
    dl.addRect(x, y, size, size, pack01(1,1,1, alpha*0.10), size*0.12, 1.0, ROUND)
}

// ---------------------------------------------------------------------------
// Navigation between tracks
// ---------------------------------------------------------------------------

var goToTrack = func(idx) {
    if (idx == curTrack) { return }
    curTrack  = idx
    playhead  = 0.0
    trackFade = 0.0   // will tween back to 1
}

var nextTrack = func() {
    var n = curTrack
    if (shuffle) {
        n = floor(rng.randfRange(0, length(library)))
        if (n == curTrack) { n = (n + 1) % length(library) }
    } else {
        n = (curTrack + 1) % length(library)
    }
    goToTrack(n)
}

var prevTrackNav = func() {
    if (playhead > 3.0) { playhead = 0.0; return }
    var n = curTrack - 1
    if (n < 0) { n = length(library) - 1 }
    goToTrack(n)
}

// ---------------------------------------------------------------------------
// Main loop
// ---------------------------------------------------------------------------

var done = false

while (!win.shouldClose() and !done) {
    var e = SDL.pollEvent()
    while (e != null) {
        if (e.type == "quit") { done = true }
        if (e.type == "key.down") {
            if (e.key == 32) { playing = !playing }       // space
        }
        e = SDL.pollEvent()
    }

    var now = Time.clock()
    var dt  = now - lastClock; lastClock = now
    if (dt < 0.0) { dt = 0.0 }
    if (dt > 0.1) { dt = 0.1 }
    frame++

    // advance playhead
    if (playing) {
        playhead = playhead + dt
        if (playhead >= library[curTrack].dur) {
            if (repeatMode == 2) { playhead = 0.0 }
            else { nextTrack() }
        }
    }

    // smooth the mock equalizer toward new random targets
    var ei = 0
    while (ei < length(eqBars)) {
        var target = 0.12
        if (playing) {
            target = 0.2 + rng.randfRange(0.0, 0.8)
        }
        eqBars[ei] = eqBars[ei] + (target - eqBars[ei]) * min(1.0, dt * 7.0)
        ei++
    }

    UI.frame(win, func() {
        var size = win.getSize()

        UI.withStyleColor({
            WindowBg:       BG,
            ChildBg:        PANEL,
            PopupBg:        PANEL,
            Text:           TEXT,
            TextDisabled:   TEXTDIM,
            Button:         [1,1,1,0.05],
            ButtonHovered:  [1,1,1,0.10],
            ButtonActive:   ACCENT,
            FrameBg:        [1,1,1,0.05],
            FrameBgHovered: [1,1,1,0.09],
            FrameBgActive:  [1,1,1,0.12],
            SliderGrab:     ACCENT,
            SliderGrabActive: mix(ACCENT, [1,1,1,1], 0.2),
            Border:         [1,1,1,0.06],
            ScrollbarBg:    [0,0,0,0],
            ScrollbarGrab:  [1,1,1,0.08],
            ScrollbarGrabHovered: [1,1,1,0.14],
            ScrollbarGrabActive:  ACCENT,
        }, func() {
        UI.withStyleVar({
            WindowRounding: 0.0, ChildRounding: 14.0, FrameRounding: 8.0,
            PopupRounding: 10.0, GrabRounding: 8.0, ScrollbarRounding: 8.0,
            WindowBorderSize: 0.0, FrameBorderSize: 0.0, ChildBorderSize: 0.0,
            WindowPadding: [18.0, 18.0], FramePadding: [10.0, 7.0],
            ItemSpacing: [12.0, 10.0], ScrollbarSize: 10.0,
        }, func() {

        UI.setNextWindowPos(0, 0)
        UI.setNextWindowSize(size.w, size.h)
        var wf = UI.WINDOW_NO_TITLE_BAR + UI.WINDOW_NO_RESIZE + UI.WINDOW_NO_MOVE
               + UI.WINDOW_NO_COLLAPSE  + UI.WINDOW_NO_SAVED_SETTINGS
               + UI.WINDOW_NO_BRING_TO_FRONT_ON_FOCUS

        UI.window("root", wf, func() {
            var dl = UI.drawList()

            // ----- responsive metrics --------------------------------------
            // below 980px wide the now-playing side panel collapses away
            var wide       = size.w >= 980
            var playerH    = 96.0
            var sidebarW   = wide ? 320.0 : 0.0
            var contentH   = size.h - playerH - 36.0

            // ===============================================================
            // Header
            // ===============================================================
            UI.withStyleColor({ Text: ACCENT }, func() { UI.text("/\\/  ZYM TUNES") })
            UI.sameLine(0, 14)
            UI.textDisabled("a modern player UI  -  mock library, no audio")
            UI.sameLine(size.w - 150)
            UI.textDisabled(str(floor(UI.framerate())) + " fps")
            UI.dummy(0, 4)

            // ===============================================================
            // Body: library list (left)  +  now-playing panel (right)
            // ===============================================================
            UI.child("body", { w:0, h:contentH, border:false }, func() {
                var listW = size.w - 36.0 - (wide ? sidebarW + 16.0 : 0.0)

                // ---- LIBRARY LIST -----------------------------------------
                UI.child("library", { w:listW, h:0, border:false }, func() {
                    var ldl = UI.drawList()
                    var lo  = UI.getCursorPos()

                    UI.withStyleColor({ Text: TEXT }, func() { UI.text("Library") })
                    UI.sameLine(0, 10)
                    UI.textDisabled(str(length(library)) + " tracks")
                    UI.dummy(0, 6)

                    // column header
                    var hdr = UI.getCursorPos()
                    ldl.addText(hdr.x + 52, hdr.y, packColor(TEXTDIM), "TITLE")
                    ldl.addText(hdr.x + listW - 230, hdr.y, packColor(TEXTDIM), "ALBUM")
                    ldl.addText(hdr.x + listW - 70, hdr.y, packColor(TEXTDIM), "TIME")
                    UI.dummy(0, 22)
                    ldl.addLine(hdr.x, hdr.y + 20, hdr.x + listW - 8, hdr.y + 20,
                        pack01(1,1,1,0.06), 1.0)

                    // rows -- each is an invisibleButton hit region with custom draw
                    var rowH = 56.0
                    var newHover = -1
                    var i = 0
                    while (i < length(library)) {
                        var tr = library[i]

                        // staggered reveal: each row eases in, trailing the one above
                        var revT = 0.0
                        if (libRevealed) { revT = 1.0 }
                        var rev = UI.animTweenFloat("lib/row/" + str(i), 1, revT,
                            0.35 + i*0.04, UI.ANIM_EASE_OUT_CUBIC,
                            UI.ANIM_POLICY_CROSSFADE, dt)

                        UI.invisibleButton("lib/hit/" + str(i), listW - 8, rowH)
                        var rmin = UI.getItemRectMin()
                        var hov  = UI.isItemHovered()
                        if (hov) { newHover = i }
                        if (UI.isItemClicked()) {
                            goToTrack(i)
                            playing = true
                        }

                        // row visual state -- hover highlight + current-track tint
                        var isCur = (i == curTrack)
                        var hoT = 0.0
                        if (hov)   { hoT = 1.0 }
                        if (isCur) { hoT = 1.0 }
                        var ho = UI.animTweenFloat("lib/ho/" + str(i), 1, hoT,
                            0.16, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

                        // slide-in offset from the stagger reveal
                        var slideX = (1.0 - rev) * 28.0
                        var a8mul  = rev
                        var rx = rmin.x + slideX
                        var ry = rmin.y

                        // row background
                        if (ho > 0.01) {
                            var bgc = [1,1,1, 0.05 * ho * a8mul]
                            if (isCur) { bgc = [ACCENT[0], ACCENT[1], ACCENT[2], 0.12 * a8mul] }
                            ldl.addRectFilled(rx, ry + 3, listW - 8, rowH - 6,
                                pack01(bgc[0],bgc[1],bgc[2],bgc[3]), 8.0, ROUND)
                        }
                        // current-track accent bar
                        if (isCur) {
                            ldl.addRectFilled(rx, ry + 10, 3, rowH - 20,
                                pack01(ACCENT[0],ACCENT[1],ACCENT[2], a8mul), 2.0, ROUND)
                        }

                        // mini cover
                        var coverSz = rowH - 18
                        drawCover(ldl, rx + 14, ry + 9, coverSz, tr.hue, a8mul)

                        // play/pause glyph on the cover when hovered or current
                        if (ho > 0.05) {
                            var gcx = rx + 14 + coverSz*0.5
                            var gcy = ry + 9 + coverSz*0.5
                            var gA  = ho * a8mul
                            ldl.addCircleFilled(gcx, gcy, 13,
                                pack01(0,0,0, 0.45*gA), 0)
                            if (isCur and playing) {
                                // pause glyph
                                ldl.addRectFilled(gcx-5, gcy-6, 3.5, 12,
                                    pack01(1,1,1,gA), 1.0, ROUND)
                                ldl.addRectFilled(gcx+1.5, gcy-6, 3.5, 12,
                                    pack01(1,1,1,gA), 1.0, ROUND)
                            } else {
                                // play triangle
                                ldl.addTriangleFilled(
                                    gcx-4, gcy-7, gcx-4, gcy+7, gcx+7, gcy,
                                    pack01(1,1,1,gA))
                            }
                        }

                        // text columns
                        var titleCol = TEXT
                        if (isCur) { titleCol = ACCENT }
                        ldl.addText(rx + 14 + coverSz + 14, ry + 13,
                            pack01(titleCol[0],titleCol[1],titleCol[2], a8mul),
                            tr.title)
                        ldl.addText(rx + 14 + coverSz + 14, ry + 32,
                            pack01(TEXTDIM[0],TEXTDIM[1],TEXTDIM[2], a8mul),
                            tr.artist)
                        ldl.addText(rx + listW - 230, ry + 22,
                            pack01(TEXTDIM[0],TEXTDIM[1],TEXTDIM[2], a8mul),
                            tr.album)
                        ldl.addText(rx + listW - 70, ry + 22,
                            pack01(TEXTDIM[0],TEXTDIM[1],TEXTDIM[2], a8mul),
                            fmtTime(tr.dur))

                        i++
                    }
                    hoveredRow = newHover
                })

                // ---- NOW-PLAYING SIDE PANEL (wide layout only) ------------
                if (wide) {
                    UI.sameLine(0, 16)
                    UI.child("nowplaying", { w:sidebarW, h:0, border:false }, func() {
                        var ndl = UI.drawList()
                        var no  = UI.getCursorPos()
                        var nw  = sidebarW - 36.0

                        // panel background card
                        ndl.addRectFilled(no.x - 9, no.y - 9, sidebarW, contentH,
                            packColor(PANEL2), 14.0, ROUND)

                        // track-change cross-fade. goToTrack() snaps trackFade
                        // to 0; here we ease it back toward 1 with a plain lerp.
                        // (A manual lerp is cleaner than an anim channel for a
                        // value that must be re-armed to 0 on demand.)
                        trackFade = trackFade + (1.0 - trackFade) * min(1.0, dt * 4.5)
                        var fade = trackFade

                        var tr = library[curTrack]

                        // big cover -- centered, scales subtly when playing
                        var coverMax = nw - 8
                        var pulse = UI.animTweenFloat("np/pulse", 1,
                            playing ? 1.0 : 0.0,
                            0.6, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
                        var breathe = 1.0
                        if (playing) {
                            breathe = 1.0 + 0.012 * sin((Time.clock()-clockStart) * 1.6)
                        }
                        var coverSz = coverMax * (0.92 + 0.08*pulse) * breathe
                        var coverX = no.x + (nw - coverSz)*0.5
                        var coverY = no.y + 6
                        // soft shadow
                        ndl.addRectFilled(coverX+6, coverY+12, coverSz, coverSz,
                            pack01(0,0,0,0.35), coverSz*0.12, ROUND)
                        drawCover(ndl, coverX, coverY, coverSz, tr.hue, fade)

                        // title + artist (fade with track change)
                        var infoY = coverY + coverSz + 20
                        var titleSz = UI.calcTextSize(tr.title)
                        ndl.addText(no.x + (nw - titleSz.x)*0.5, infoY,
                            pack01(TEXT[0],TEXT[1],TEXT[2], fade), tr.title)
                        var artSz = UI.calcTextSize(tr.artist + "  -  " + tr.album)
                        ndl.addText(no.x + (nw - artSz.x)*0.5, infoY + 22,
                            pack01(TEXTDIM[0],TEXTDIM[1],TEXTDIM[2], fade),
                            tr.artist + "  -  " + tr.album)

                        // animated equalizer strip
                        var eqY = infoY + 56
                        var eqH = 46.0
                        var nb  = length(eqBars)
                        var bw  = (nw - (nb-1)*3.0) / nb
                        var bi = 0
                        while (bi < nb) {
                            var lvl = eqBars[bi]
                            var bh  = 4.0 + lvl * eqH
                            var bx  = no.x + bi*(bw + 3.0)
                            var by  = eqY + (eqH - bh)
                            // gradient-ish: lerp accent->accent2 by level
                            var bc = mix(ACCENT2, ACCENT, lvl)
                            ndl.addRectFilled(bx, by, bw, bh,
                                pack01(bc[0],bc[1],bc[2], 0.85), 2.0, ROUND)
                            bi++
                        }

                        // up-next preview
                        var unY = eqY + eqH + 22
                        ndl.addText(no.x, unY, packColor(TEXTDIM), "UP NEXT")
                        var nxt = (curTrack + 1) % length(library)
                        var ntr = library[nxt]
                        drawCover(ndl, no.x, unY + 20, 38, ntr.hue, 1.0)
                        ndl.addText(no.x + 50, unY + 24,
                            packColor(TEXT), ntr.title)
                        ndl.addText(no.x + 50, unY + 42,
                            packColor(TEXTDIM), ntr.artist)

                        UI.dummy(nw, contentH - 20)
                    })
                }
            })

            UI.dummy(0, 6)

            // ===============================================================
            // Player bar (bottom)
            // ===============================================================
            UI.child("player", { w:0, h:playerH - 8, border:false }, func() {
                var pdl = UI.drawList()
                var po  = UI.getCursorPos()
                var pw  = size.w - 36.0
                var tr  = library[curTrack]

                // panel card
                pdl.addRectFilled(po.x - 9, po.y - 9, size.w, playerH,
                    packColor(PANEL2), 14.0, ROUND)

                // ---- left: mini cover + track text ------------------------
                var miniSz = 56.0
                drawCover(pdl, po.x, po.y, miniSz, tr.hue, 1.0)
                pdl.addText(po.x + miniSz + 14, po.y + 8,
                    packColor(TEXT), tr.title)
                pdl.addText(po.x + miniSz + 14, po.y + 28,
                    packColor(TEXTDIM), tr.artist)

                // ---- center: transport controls ---------------------------
                var ctrlCY = po.y + 22
                var centerX = po.x + pw*0.5

                // helper for a round icon button drawn at (cx, cy)
                // returns true on click. `r` radius, `kind` chooses the glyph.
                var iconBtn = func(id, cx, cy, r, kind, primary) {
                    UI.setCursorScreenPos(cx - r, cy - r)
                    UI.invisibleButton(id, r*2, r*2)
                    var hov = UI.isItemHovered()
                    var act = UI.isItemActive()
                    var clicked = UI.isItemClicked()

                    var sT = 1.0
                    if (hov) { sT = 1.12 }
                    if (act) { sT = 0.94 }
                    var sc = UI.animTweenFloat("pb/" + id + "/s", 1, sT,
                        0.15, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
                    var rr = r * sc

                    if (primary) {
                        // filled accent disc
                        var glow = UI.animTweenFloat("pb/" + id + "/g", 1,
                            hov ? 1.0 : 0.0, 0.18, UI.ANIM_EASE_OUT_CUBIC,
                            UI.ANIM_POLICY_CROSSFADE, dt)
                        if (glow > 0.01) {
                            pdl.addCircleFilled(cx, cy, rr + 5,
                                pack01(ACCENT[0],ACCENT[1],ACCENT[2], 0.25*glow), 0)
                        }
                        pdl.addCircleFilled(cx, cy, rr,
                            packColor(ACCENT), 0)
                    } else {
                        if (hov) {
                            pdl.addCircleFilled(cx, cy, rr,
                                pack01(1,1,1, 0.08), 0)
                        }
                    }

                    var gc = packColor(TEXT)
                    if (primary) { gc = pack01(0.05,0.06,0.08,1.0) }

                    // glyphs
                    if (kind == "prev" or kind == "next") {
                        var dir = 1.0
                        if (kind == "prev") { dir = -1.0 }
                        var gx = cx; var gw = rr*0.5
                        // two triangles + a bar
                        pdl.addTriangleFilled(
                            gx + dir*gw,      cy - rr*0.42,
                            gx + dir*gw,      cy + rr*0.42,
                            gx - dir*0.06*rr, cy, gc)
                        pdl.addTriangleFilled(
                            gx,               cy - rr*0.42,
                            gx,               cy + rr*0.42,
                            gx - dir*gw,      cy, gc)
                        pdl.addRectFilled(
                            gx + dir*gw - (dir>0?0:2.5), cy - rr*0.42,
                            2.5, rr*0.84, gc, 1.0, ROUND)
                    }
                    if (kind == "playpause") {
                        // morph play<->pause via a blend factor
                        var ppT = 0.0
                        if (playing) { ppT = 1.0 }
                        var pp = UI.animTweenFloat("pb/pp-morph", 1, ppT,
                            0.2, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
                        // play triangle shrinks as two pause bars grow
                        if (pp < 0.55) {
                            var pa = 1.0 - pp/0.55
                            pdl.addTriangleFilled(
                                cx - rr*0.30, cy - rr*0.42*pa - (1-pa)*0,
                                cx - rr*0.30, cy + rr*0.42*pa,
                                cx + rr*0.40, cy,
                                pack01(gc==packColor(TEXT)?TEXT[0]:0.05,
                                       gc==packColor(TEXT)?TEXT[1]:0.06,
                                       gc==packColor(TEXT)?TEXT[2]:0.08, pa))
                        }
                        if (pp > 0.45) {
                            var pb2 = (pp - 0.45)/0.55
                            var barH = rr*0.78 * pb2
                            var col = pack01(0.05,0.06,0.08, pb2)
                            pdl.addRectFilled(cx - rr*0.34, cy - barH*0.5,
                                rr*0.26, barH, col, 1.5, ROUND)
                            pdl.addRectFilled(cx + rr*0.08, cy - barH*0.5,
                                rr*0.26, barH, col, 1.5, ROUND)
                        }
                    }
                    if (kind == "shuffle") {
                        var on = shuffle
                        var lc = packColor(TEXTDIM)
                        if (on) { lc = packColor(ACCENT) }
                        // two crossing arrows -- simplified as crossing lines
                        pdl.addLine(cx-rr*0.55, cy-rr*0.35, cx+rr*0.55, cy+rr*0.35, lc, 2.0)
                        pdl.addLine(cx-rr*0.55, cy+rr*0.35, cx+rr*0.55, cy-rr*0.35, lc, 2.0)
                        pdl.addTriangleFilled(
                            cx+rr*0.55, cy+rr*0.35, cx+rr*0.25, cy+rr*0.45,
                            cx+rr*0.50, cy+rr*0.05, lc)
                        pdl.addTriangleFilled(
                            cx+rr*0.55, cy-rr*0.35, cx+rr*0.25, cy-rr*0.45,
                            cx+rr*0.50, cy-rr*0.05, lc)
                    }
                    if (kind == "repeat") {
                        var lc = packColor(TEXTDIM)
                        if (repeatMode > 0) { lc = packColor(ACCENT) }
                        // loop arc -- approximate with a circle outline + arrow
                        pdl.addCircle(cx, cy, rr*0.5, lc, 0, 2.0)
                        pdl.addTriangleFilled(
                            cx+rr*0.5, cy-rr*0.18, cx+rr*0.5, cy+rr*0.18,
                            cx+rr*0.8, cy, lc)
                        if (repeatMode == 2) {
                            // a "1" dot to signal repeat-one
                            pdl.addCircleFilled(cx, cy, 2.4, lc, 0)
                        }
                    }
                    return clicked
                }

                // lay the five transport buttons along the center
                if (iconBtn("shuffle", centerX - 120, ctrlCY, 16, "shuffle", false)) {
                    shuffle = !shuffle
                }
                if (iconBtn("prev", centerX - 64, ctrlCY, 18, "prev", false)) {
                    prevTrackNav()
                }
                if (iconBtn("playpause", centerX, ctrlCY, 26, "playpause", true)) {
                    playing = !playing
                }
                if (iconBtn("next", centerX + 64, ctrlCY, 18, "next", false)) {
                    nextTrack()
                }
                if (iconBtn("repeat", centerX + 120, ctrlCY, 16, "repeat", false)) {
                    repeatMode = (repeatMode + 1) % 3
                }

                // ---- seek bar (under the transport row) -------------------
                var barY = po.y + 56
                var barX0 = centerX - 220
                var barX1 = centerX + 220
                var barW  = barX1 - barX0
                var prog  = playhead / tr.dur
                if (prog > 1.0) { prog = 1.0 }

                // hit region for scrubbing
                UI.setCursorScreenPos(barX0, barY - 8)
                UI.invisibleButton("pb/seek", barW, 18)
                seekHover = UI.isItemHovered()
                if (UI.isItemActive()) {
                    seekGrab = true
                    var mp = UI.getMousePos()
                    var t  = (mp.x - barX0) / barW
                    if (t < 0.0) { t = 0.0 }
                    if (t > 1.0) { t = 1.0 }
                    playhead = t * tr.dur
                    prog = t
                } else {
                    seekGrab = false
                }

                // bar thickness eases up on hover
                var thT = 3.0
                if (seekHover or seekGrab) { thT = 6.0 }
                var th = UI.animTweenFloat("pb/seek-th", 1, thT,
                    0.16, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)

                // track + fill
                pdl.addRectFilled(barX0, barY - th*0.5, barW, th,
                    pack01(1,1,1,0.10), th*0.5, ROUND)
                pdl.addRectFilled(barX0, barY - th*0.5, barW*prog, th,
                    packColor(ACCENT), th*0.5, ROUND)
                // knob -- appears on hover
                var knobT = 0.0
                if (seekHover or seekGrab) { knobT = 1.0 }
                var knob = UI.animTweenFloat("pb/seek-knob", 1, knobT,
                    0.16, UI.ANIM_EASE_OUT_CUBIC, UI.ANIM_POLICY_CROSSFADE, dt)
                if (knob > 0.01) {
                    pdl.addCircleFilled(barX0 + barW*prog, barY, 7.0*knob,
                        packColor(TEXT), 0)
                }
                // time labels
                pdl.addText(barX0 - 44, barY - 7,
                    packColor(TEXTDIM), fmtTime(playhead))
                pdl.addText(barX1 + 10, barY - 7,
                    packColor(TEXTDIM), fmtTime(tr.dur))

                // ---- right: volume ----------------------------------------
                var volX0 = po.x + pw - 150
                var volX1 = po.x + pw - 20
                var volY  = po.y + 34
                // speaker glyph
                pdl.addTriangleFilled(
                    volX0-18, volY-5, volX0-18, volY+5, volX0-10, volY+8,
                    packColor(TEXTDIM))
                pdl.addTriangleFilled(
                    volX0-18, volY-5, volX0-10, volY-8, volX0-10, volY+8,
                    packColor(TEXTDIM))
                pdl.addRectFilled(volX0-26, volY-4, 8, 8,
                    packColor(TEXTDIM), 1.0, ROUND)

                UI.setCursorScreenPos(volX0, volY - 8)
                UI.invisibleButton("pb/vol", volX1 - volX0, 16)
                var volHov = UI.isItemHovered()
                if (UI.isItemActive()) {
                    var mp = UI.getMousePos()
                    var t  = (mp.x - volX0) / (volX1 - volX0)
                    if (t < 0.0) { t = 0.0 }
                    if (t > 1.0) { t = 1.0 }
                    volume[0] = t
                }
                var vth = 4.0
                if (volHov) { vth = 6.0 }
                pdl.addRectFilled(volX0, volY - vth*0.5, volX1-volX0, vth,
                    pack01(1,1,1,0.10), vth*0.5, ROUND)
                pdl.addRectFilled(volX0, volY - vth*0.5, (volX1-volX0)*volume[0], vth,
                    packColor(TEXT), vth*0.5, ROUND)
                pdl.addCircleFilled(volX0 + (volX1-volX0)*volume[0], volY, 5.0,
                    packColor(TEXT), 0)

                UI.dummy(pw, playerH - 20)
            })

            // trigger the staggered library reveal once, on the first frame
            if (!libRevealed and frame > 2) { libRevealed = true }
        }) // window
        }) // withStyleVar
        }) // withStyleColor
    }) // UI.frame
}

win.free()
