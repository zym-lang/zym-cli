var pageWidgets = func() {
    var ws = win.getSize()
    var hw = (ws.w - 80) / 2

    UI.child("wl", { w: hw, h: 0, border: false }, func() {
        secHeader("Buttons & Toggles", "")

        if (UI.button("Regular")) {}
        UI.sameLine()
        if (UI.smallButton("Small")) {}
        UI.sameLine()
        if (UI.arrowButton("al",0)){} UI.sameLine()
        if (UI.arrowButton("ar",1)){} UI.sameLine()
        if (UI.arrowButton("au",2)){} UI.sameLine()
        if (UI.arrowButton("ad",3)){}

        UI.dummy(0,4)
        UI.checkbox("Option A", checkA)
        UI.checkbox("Option B", checkB)
        UI.checkbox("Option C", checkC)
        UI.dummy(0,4)
        UI.radioButton("Radio 0", radio[0]==0); if(UI.isItemClicked()){radio[0]=0}
        UI.sameLine()
        UI.radioButton("Radio 1", radio[0]==1); if(UI.isItemClicked()){radio[0]=1}
        UI.sameLine()
        UI.radioButton("Radio 2", radio[0]==2); if(UI.isItemClicked()){radio[0]=2}
        UI.dummy(0,4)
        UI.withStyleColor({ Button:accent[0], ButtonHovered:mix(accent[0],white,0.18), ButtonActive:mix(accent[0],black,0.18) }, func() {
            if (UI.button("Accent", 120, 0)) {}
            UI.sameLine()
            if (UI.button("Modal...", 100, 0)) { showModal = true }
        })

        UI.dummy(0,8)
        secHeader("Sliders & Drags", "")
        UI.sliderInt("Integer",   sliderI, 0, 100)
        UI.sliderFloat("Float",   sliderF, 0.0, 1.0, "%.3f")
        UI.sliderAngle("Angle",   angleRef, -180.0, 180.0)
        UI.dragInt("Drag int",    dragI, 1, -100, 100)
        UI.dragFloat("Drag float",dragF, 0.01, 0.0, 10.0)
        UI.sliderFloat2("Vec2",   vec2ref, 0.0, 1.0)
        UI.sliderFloat3("Vec3",   vec3ref, 0.0, 1.0)

        UI.dummy(0,8)
        secHeader("Progress", "")
        progress[0] = progress[0] + 0.002
        if (progress[0] > 1.0) { progress[0] = 0.0 }
        UI.progressBar(progress[0], -1, 0, str(floor(progress[0]*100)) + "%")
        UI.progressBar(0.42, -1, 0, "CPU 42%")
        UI.progressBar(0.71, -1, 0, "MEM 71%")

        UI.dummy(0,8)
        secHeader("Drag & Drop", "drag items between lists")

        UI.child("dnd-l", { w: 150, h: 130, border: true }, func() {
            UI.textDisabled("Inventory")
            UI.separator()
            var di = 0
            while (di < length(dndLeft)) {
                var item = dndLeft[di]
                UI.id("dl-"+str(di), func() {
                    UI.selectable(item, false)
                    if (UI.beginDragDropSource()) {
                        UI.setDragDropPayload("ITEM","L:"+str(di))
                        UI.text("  "+item)
                        UI.endDragDropSource()
                    }
                })
                di++
            }
            if (UI.beginDragDropTarget()) {
                var p = UI.acceptDragDropPayload("ITEM")
                if (p != null and startsWith(p,"R:")) {
                    var idx = num(slice(p,2,length(p)))
                    if (idx >= 0 and idx < length(dndRight)) { push(dndLeft,dndRight[idx]); remove(dndRight,idx) }
                }
                UI.endDragDropTarget()
            }
        })
        UI.sameLine()
        UI.child("dnd-r", { w: 150, h: 130, border: true }, func() {
            UI.textDisabled("Equipped")
            UI.separator()
            var di = 0
            while (di < length(dndRight)) {
                var item = dndRight[di]
                UI.id("dr-"+str(di), func() {
                    UI.selectable(item, false)
                    if (UI.beginDragDropSource()) {
                        UI.setDragDropPayload("ITEM","R:"+str(di))
                        UI.text("  "+item)
                        UI.endDragDropSource()
                    }
                })
                di++
            }
            if (UI.beginDragDropTarget()) {
                var p = UI.acceptDragDropPayload("ITEM")
                if (p != null and startsWith(p,"L:")) {
                    var idx = num(slice(p,2,length(p)))
                    if (idx >= 0 and idx < length(dndLeft)) { push(dndRight,dndLeft[idx]); remove(dndLeft,idx) }
                }
                UI.endDragDropTarget()
            }
        })
    })

    UI.sameLine()

    UI.child("wr", { w: 0, h: 0, border: false }, func() {
        secHeader("Text Inputs", "")
        UI.inputText("Single line", textBuf)
        UI.inputTextMultiline("Multi-line", mlBuf, -1, 120)

        UI.dummy(0,8)
        secHeader("Color", "")
        UI.colorEdit("Edit RGBA", colorRef)
        UI.colorPicker("Picker", colorRef)

        UI.dummy(0,8)
        secHeader("Combo & List", "")
        UI.combo("Combo", combo1, combo1Items)
        UI.dummy(0,4)
        UI.listBox("List", listIdx, listItems)

        UI.dummy(0,8)
        secHeader("Tooltips & Context", "")
        UI.button("Hover (rich)")
        if (UI.isItemHovered()) {
            UI.tooltipScope(func() {
                UI.text("Rich tooltip")
                UI.separator()
                UI.textDisabled("Any widget can go here")
                UI.progressBar(0.65, 160, 0, "progress")
            })
        }
        UI.sameLine()
        UI.button("Hover (simple)")
        if (UI.isItemHovered()) { UI.tooltip("Simple tooltip") }

        UI.child("ctx-box", { w:0, h:50, border:true }, func() {
            UI.setCursorPos(12, 16)
            UI.textDisabled("right-click me")
        })
        UI.popupContextWindow("ctx-w", func() {
            UI.text("Context menu")
            UI.separator()
            if (UI.menuItem("Action A")) {}
            if (UI.menuItem("Action B")) {}
        })
    })

    if (showModal) { UI.openPopup("w-modal"); showModal = false }
    UI.popupModal("w-modal", func() {
        UI.text("Modal dialog")
        UI.separator()
        UI.textWrapped("Type something:")
        UI.dummy(0,4)
        UI.inputText("##mi", modalInput)
        UI.dummy(0,8)
        UI.withStyleColor({ Button:accent[0], ButtonHovered:mix(accent[0],white,0.18), ButtonActive:mix(accent[0],black,0.18) }, func() {
            if (UI.button("Confirm", 100, 0)) { modalResult = modalInput.toUtf8(); modalInput.fill(0); UI.closeCurrentPopup() }
        })
        UI.sameLine()
        if (UI.button("Cancel", 100, 0)) { UI.closeCurrentPopup() }
        if (modalResult != "") { UI.sameLine(0,16); UI.textColored(accent[0], "Last: "+modalResult) }
    })
}

