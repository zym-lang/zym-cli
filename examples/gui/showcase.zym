    UI.collapsingHeader("Collapsing header")
    UI.dummy(0,8)
    secHeader("Tab bar", "")
    UI.tabBar("layout-tabs", func() {
        UI.tabItem("Tab One", func() { UI.text("Content of Tab One"); UI.button("Action") })
