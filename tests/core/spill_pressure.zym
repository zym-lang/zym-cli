  var w181 = nn
  var w182 = nn
  var w183 = nn
  var w184 = nn
  var w185 = nn
  var w186 = nn
  var w187 = nn
  var w188 = nn
  var w189 = nn
  var w190 = nn
  var w191 = nn
  var w192 = nn
  var w193 = nn
  var w194 = nn
  var w195 = nn
  var w196 = nn
  var w197 = nn
  var w198 = nn
  var w199 = nn
  if (nn <= 0) { return 0 }
  var sub = rec(nn - 1)
  assert(w199 == nn, "spilled local survives the recursive call")
  return sub + 1
}
assert(rec(50) == 50, "deep recursion with per-frame spills")

print("ALL SPILL PRESSURE TESTS PASSED")
