func case4() {
    HELD = Cont.withPrompt(TAG, c4_victim)
    GC.cycle()
    GC.cycle()
    return Cont.withPrompt(TAG, resumeHeld)
}

// ---------------------------------------------------------------------------
// [5] Cont.shift reaches captureContinuation by its own path and then pushes
// the handler frame itself, so it gets its own case. The handler parks the
// continuation and returns; resuming it later must still find 2044.
// ---------------------------------------------------------------------------
func c5_handler(k) {
    HELD = k
    return 0
}

