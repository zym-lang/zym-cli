        })
    })

    UI.dummy(0,8)
    secHeader("Trees & Headers", "")
    UI.treeNode("Root", func() {
        UI.treeNode("Child A", func() {
            UI.bulletText("Leaf 1"); UI.bulletText("Leaf 2"); UI.bulletText("Leaf 3")
        })
        UI.treeNode("Child B", func() {
            UI.treeNode("Grandchild", func() {
                UI.bulletText("Deep leaf")
                UI.sliderInt("##deep", [50], 0, 100)
            })
        })
    })
    UI.collapsingHeader("Collapsing header")
    UI.dummy(0,8)
    secHeader("Tab bar", "")
    UI.tabBar("layout-tabs", func() {
        UI.tabItem("Tab One", func() { UI.text("Content of Tab One"); UI.button("Action") })
        UI.tabItem("Tab Two", func() { UI.text("Content of Tab Two"); UI.progressBar(0.55,-1,0,"55%") })
        UI.tabItem("Tab Three", func() { UI.text("Content of Tab Three"); UI.checkbox("A checkbox",[true]) })
        UI.tabItemButton("+")
    })
}

