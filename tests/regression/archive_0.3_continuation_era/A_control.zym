// CONTROL: a single, NON-nested withPrompt + abort.
// Expect: prompt_count returns to 0, so the first Cont.popPrompt() must ERROR.
var OUTER = Cont.newPrompt("OUTER")

func body() {
    print("body: aborting OUTER")
    Cont.abort(OUTER, "AV")
    print("body: NOT REACHED")
    return 0
}

var r = Cont.withPrompt(OUTER, body)
print("withPrompt returned:")
print(r)

print("now probing leftover prompt entries...")
Cont.popPrompt()
print("LEAK: pop #1 succeeded (prompt_count was >= 1)")
Cont.popPrompt()
print("LEAK: pop #2 succeeded (prompt_count was >= 2)")
