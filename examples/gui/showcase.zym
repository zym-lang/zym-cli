    UI.child("ll", { w: hw, h: 340, border: false }, func() {
        secHeader("Scrollable list", "30 items")
        UI.child("scroll", { w: 0, h: 310, border: true }, func() {
            var i = 0
            while (i < 30) {
                UI.id(i, func() {
                    UI.textDisabled(str(i+1)+".")
                    UI.sameLine()
                    UI.text("Item "+str(i+1)+"  -  scroll to see more content here")
                    UI.sameLine()
                    UI.withStyleColor({ Button: mix(accent[0],black,0.5) }, func() { UI.smallButton("pick") })
                })
                i++
            }
        })
    })
    UI.sameLine()
    UI.child("lr", { w: 0, h: 340, border: false }, func() {
        secHeader("Groups & same-line", "")
        UI.group(func() {
            UI.text("Group A"); UI.separator()
            UI.button("Btn 1"); UI.button("Btn 2"); UI.button("Btn 3")
        })
        UI.sameLine(0,24)
        UI.group(func() {
            UI.text("Group B"); UI.separator()
            UI.button("Btn 4"); UI.button("Btn 5"); UI.button("Btn 6")
        })
        UI.sameLine(0,24)
        UI.group(func() {
            UI.text("Sliders"); UI.separator()
            UI.sliderFloat("##sg1", [0.4], 0, 1)
            UI.sliderFloat("##sg2", [0.6], 0, 1)
            UI.sliderFloat("##sg3", [0.8], 0, 1)
        })
        UI.dummy(0,12)
        secHeader("Indent levels", "")
        UI.text("Level 0"); UI.indent()
        UI.text("Level 1"); UI.indent()
        UI.text("Level 2"); UI.indent()
        UI.text("Level 3"); UI.unindent(); UI.unindent(); UI.unindent()
        UI.dummy(0,12)
        secHeader("Disabled region", "")
        UI.checkbox("Enable inputs", disableInputs)
        UI.disabled(!disableInputs[0], func() {
            UI.inputText("##dis", Buffer.new(64))
            UI.sliderFloat("##dis2", [0.5], 0, 1)
